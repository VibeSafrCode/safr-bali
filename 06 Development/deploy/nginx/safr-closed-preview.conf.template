# Closed isolated preview. This file must never replace the production
# safr-web configuration.
#
# The public site requires /etc/nginx/safr-preview.htpasswd.
# Telegram WebView cannot complete HTTP Basic Auth, so the React preview uses
# a separate high-entropy entry key. The key is rendered only on the preview
# server and is exchanged for a short-lived Secure/HttpOnly cookie.

limit_req_zone $binary_remote_addr zone=safr_preview_public_api:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=safr_preview_app_api:10m rate=15r/s;

map $arg_preview_key $safr_preview_query_allowed {
    default 0;
    "__APP_PREVIEW_GATE__" 1;
}

map $cookie_safr_preview_gate $safr_preview_cookie_allowed {
    default 0;
    "__APP_PREVIEW_GATE__" 1;
}

map "$safr_preview_query_allowed:$safr_preview_cookie_allowed" $safr_preview_app_allowed {
    default 0;
    "1:0" 1;
    "0:1" 1;
    "1:1" 1;
}

map $arg_preview_key $safr_preview_gate_cookie {
    default "";
    "__APP_PREVIEW_GATE__" "safr_preview_gate=__APP_PREVIEW_GATE__; Path=/; Max-Age=86400; Secure; HttpOnly; SameSite=None";
}

server {
    listen 127.0.0.1:8082 default_server;
    server_name _;

    auth_basic "SAFRWAY closed preview";
    auth_basic_user_file /etc/nginx/safr-preview.htpasswd;

    root /var/www/safr-preview/current/astro-site;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    location = /account {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8002/api/web/account-redirect;
    }

    location = /account/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8002/api/web/account-redirect;
    }

    location = /api/web/chat/guest {
        limit_req zone=safr_preview_public_api burst=5 nodelay;
        client_max_body_size 32k;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8002;
    }

    location = /404.html {
        internal;
    }

    location ~* \.(?:css|js|png|jpg|jpeg|webp|svg|ico|woff2?)$ {
        expires 1h;
        add_header Cache-Control "private, max-age=3600";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
}

server {
    listen 127.0.0.1:8083 default_server;
    server_name _;

    if ($safr_preview_app_allowed = 0) {
        return 404;
    }

    root /var/www/safr-preview/current/react-app;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org; base-uri 'none'; form-action 'self'" always;
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    add_header Set-Cookie $safr_preview_gate_cookie always;

    location ^~ /mini-app/ {
        limit_req zone=safr_preview_app_api burst=20 nodelay;
        client_max_body_size 1m;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8002;
    }

    location ^~ /api/web/ {
        limit_req zone=safr_preview_app_api burst=20 nodelay;
        client_max_body_size 1m;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8002;
    }

    location = /account {
        return 307 /account/;
    }

    location = / {
        try_files /index.html =404;
    }

    location ~ ^/account/(?:[A-Za-z0-9_-]+/)*$ {
        try_files /account/index.html =404;
    }

    location ^~ /assets/ {
        expires 1h;
        add_header Cache-Control "private, max-age=3600";
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
