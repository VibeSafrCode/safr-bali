# Closed static preview. This file must never replace the production
# safr-web configuration.
#
# Render __APP_PREVIEW_URL__ after the temporary HTTPS URL is known.
# Both servers require /etc/nginx/safr-preview.htpasswd.

server {
    listen 127.0.0.1:8082 default_server;
    server_name _;

    auth_basic "SAFRWAY closed preview";
    auth_basic_user_file /etc/nginx/safr-preview.htpasswd;

    root /var/www/safr-preview/current/astro-site;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    location = /account {
        return 307 __APP_PREVIEW_URL__/account/;
    }

    location = /account/ {
        return 307 __APP_PREVIEW_URL__/account/;
    }

    location ^~ /api/ {
        default_type application/json;
        return 503 '{"detail":"Closed preview is isolated from production data"}';
    }

    location = /404.html {
        internal;
    }

    location ~* \.(?:css|js|png|jpg|jpeg|webp|svg|ico|woff2?)$ {
        expires 1h;
        add_header Cache-Control "private, max-age=3600";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
}

server {
    listen 127.0.0.1:8083 default_server;
    server_name _;

    auth_basic "SAFRWAY closed preview";
    auth_basic_user_file /etc/nginx/safr-preview.htpasswd;

    root /var/www/safr-preview/current/react-app;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org; base-uri 'none'; form-action 'self'" always;
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;

    location ^~ /mini-app/ {
        default_type application/json;
        return 503 '{"detail":"Closed preview is isolated from production data"}';
    }

    location ^~ /api/ {
        default_type application/json;
        return 503 '{"detail":"Closed preview is isolated from production data"}';
    }

    location = /account {
        return 307 /account/;
    }

    location = / {
        try_files /index.html =404;
    }

    location ~ ^/account/(?:[A-Za-z0-9_-]+/)*$ {
        try_files /account/index.html =404;
    }

    location ^~ /assets/ {
        expires 1h;
        add_header Cache-Control "private, max-age=3600";
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
