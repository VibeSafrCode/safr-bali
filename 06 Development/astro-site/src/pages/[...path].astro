---
import type { GetStaticPaths } from "astro";

import PublicPage from "../components/PublicPage.astro";
import {
  getPublicPages,
  type PublicPage as PublicPageEntry,
} from "../lib/public-catalog";

export const getStaticPaths: GetStaticPaths = async () =>
  getPublicPages()
    .filter((page) => page.route !== "/")
    .map((page) => ({
      params: {
        path: page.route.slice(1, -1),
      },
      props: {
        page,
      },
    }));

interface Props {
  page: PublicPageEntry;
}

const { page } = Astro.props;
---

<PublicPage {page} />
