---
import type {GetStaticPaths} from 'astro';
import PublicPage from '../components/PublicPage.astro';
import RegistryPublicPage from '../components/registry/RegistryPublicPage.astro';
import UaeWorld from '../components/UaeWorld.astro';
import {buildPublicRegistryModel} from '../../scripts/registry-publication.mjs';
import {publicSiteEntries} from '../lib/public-site-publication';
export const getStaticPaths:GetStaticPaths=()=>publicSiteEntries()
 .filter(row=>row.route!=='/'&&!(row.kind==='standalone'&&(row.locale==='ru'||row.locale==='en')))
 .map(siteEntry=>({params:{path:siteEntry.route.slice(1,-1)},props:{siteEntry}}));
interface Props{siteEntry:ReturnType<typeof publicSiteEntries>[number];}
const {siteEntry}=Astro.props;
const registry=siteEntry.kind==='registry'?buildPublicRegistryModel(siteEntry.page):null;
---
{registry?<RegistryPublicPage model={registry}/>:siteEntry.kind==='standalone'?<UaeWorld locale={siteEntry.locale}/>:<PublicPage page={siteEntry.page} locale={siteEntry.locale}/>}
