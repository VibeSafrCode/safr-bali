---
import "../styles/global.css";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SupportLauncher from "../components/SupportLauncher.astro";
import LanguageSuggestion from "../components/LanguageSuggestion.astro";
import themeScriptUrl from "../client/theme.js?url&no-inline";
import authStateScriptUrl from "../client/auth-state.js?url&no-inline";
import languageScriptUrl from "../client/language.js?url&no-inline";
import { canonicalUrl, jsonLdForPage, serializeJsonLd, ogImagePath } from "../lib/seo";
import {
  publicAlternates,
  publicText,
  sourceRoute,
  type PublicLocale,
} from "../lib/public-i18n";

interface Props {
  route: string;
  title: string;
  description: string;
  indexable: boolean;
  lastModified?: string;
  hasEditorial?: boolean;
  breadcrumbs: Array<{ label: string; href: string }>;
  download?: {
    href: string;
    fileName: string;
    mediaType: string;
    sizeBytes: number;
    language: string;
    updatedAt: string;
  };
  locale?: PublicLocale;
}

const { route, title, description, indexable, breadcrumbs, download, lastModified, hasEditorial = false, locale = "ru" } = Astro.props;
const routeSource = sourceRoute(route);
const canonical = canonicalUrl(route);
const fullTitle = title.includes("SAFRWAY") ? title : `${title} — SAFRWAY`;
const robots = indexable ? "index,follow" : "noindex,follow";
const alternates = indexable ? publicAlternates(route) : [];
const ogImage = canonicalUrl(ogImagePath(route));
const jsonLd = serializeJsonLd(
  jsonLdForPage({
    route,
    title: fullTitle,
    description,
    indexable,
    breadcrumbs,
    download,
    locale,
    homeLabel: publicText("ui.nav.home", locale),
    lastModified,
  }),
);
---

<!doctype html>
<html lang={locale} data-locale={locale} data-theme="dark" data-editorial={hasEditorial ? "true" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1914" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alternates.map((entry) => <link rel="alternate" hreflang={entry.locale} href={canonicalUrl(entry.href)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "ru_RU"} />
    <meta property="og:locale:alternate" content={locale === "en" ? "ru_RU" : "en_US"} />
    <meta property="og:site_name" content="SAFRWAY" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{fullTitle}</title>
    <script is:inline src={languageScriptUrl}></script>
    <script is:inline type="module" src={themeScriptUrl}></script>
    <script is:inline type="module" src={authStateScriptUrl}></script>
    <script>import "../client/pricing.js";</script>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body
    class:list={[
      { "route-home": routeSource === "/" },
      { "route-visa-catalog": routeSource === "/bali/visas/" },
      { "route-exchange-login": routeSource === "/bali/exchange/usdt-idr/" },
      { "route-download-guide": Boolean(download) },
    ]}
  >
    <SiteHeader {route} {locale} />
    <LanguageSuggestion {route} {locale} />
    <main id="content">
      <slot />
    </main>
    <SupportLauncher {locale} />
    <SiteFooter {locale} />
  </body>
</html>
