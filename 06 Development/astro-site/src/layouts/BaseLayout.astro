---
import {serializePublicInteractionCaptions} from '../lib/public-interactions.mjs';
import "../styles/global.css";
import "../styles/interaction-polish.css";
import "../styles/service-apps.css";
import "../styles/destination-worlds.css";
import "../styles/support-dialog.css";
import "../styles/country-picker.css";
import "../styles/bali-services.css";
import "../../../shared/design/client-night-palette.css";
import WorldBackdrop from "../components/WorldBackdrop.astro";
import worldScriptUrl from "../client/destination-worlds.js?url&no-inline";

import SiteFooter from "../components/SiteFooter.astro";
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import SiteHeader from "../components/SiteHeader.astro";
import SupportLauncher from "../components/SupportLauncher.astro";
import LanguageSuggestion from "../components/LanguageSuggestion.astro";
import authStateScriptUrl from "../client/auth-state.js?url&no-inline";
import languageScriptUrl from "../client/language.js?url&no-inline";
import { canonicalUrl, jsonLdForPage, serializeJsonLd, ogImagePath } from "../lib/seo";
import {
  publicText,
  sourceRoute,
  type PublicSourceLocale,
} from "../lib/public-i18n";
import {publicLocaleDirection,publicLocaleOgCode} from '../lib/public-locale';
import {publicSiteAlternates} from '../lib/public-site-publication';

interface Props {
  route: string;
  title: string;
  description: string;
  indexable: boolean;
  lastModified?: string;
  hasEditorial?: boolean;
  breadcrumbs: Array<{ label: string; href: string }>;
  download?: {
    href: string;
    fileName: string;
    mediaType: string;
    sizeBytes: number;
    language: string;
    updatedAt: string;
  };
  locale?: PublicSourceLocale;
  languageChoices?: import("../client/public-selector-policy.mjs").LanguageChoice[];
}

const { route, title, description, indexable, breadcrumbs, download, lastModified, hasEditorial = false, locale = "ru", languageChoices } = Astro.props;
const routeSource = sourceRoute(route);
const world = routeSource === '/' ? 'bali' : ['bali','thailand','russia','nepal','uae'].find(id => routeSource.startsWith(`/${id}/`));
const canonical = canonicalUrl(route);
const fullTitle = title.includes("SAFRWAY") ? title : `${title} — SAFRWAY`;
const robots = indexable ? "index,follow" : "noindex,follow";
const alternates = indexable ? publicSiteAlternates(route) : [];
const ogImage = canonicalUrl(ogImagePath(route));
const jsonLd = serializeJsonLd(
  jsonLdForPage({
    route,
    title: fullTitle,
    description,
    indexable,
    breadcrumbs,
    download,
    locale,
    homeLabel: publicText("ui.nav.home", locale),
    lastModified,
  }),
);
---

<!doctype html>
<html data-public-night="true" lang={locale} dir={publicLocaleDirection(locale)} data-locale={locale} data-world={world} data-theme="dark" data-editorial={hasEditorial ? "true" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080c15" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alternates.map((entry) => <link rel="alternate" hreflang={entry.locale} href={canonicalUrl(entry.href)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={publicLocaleOgCode(locale)} />
    {alternates.filter(entry=>entry.locale!==locale&&entry.locale!=='x-default').map(entry=><meta property="og:locale:alternate" content={publicLocaleOgCode(entry.locale)} />)}
    <meta property="og:site_name" content="SAFRWAY" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{fullTitle}</title>
    <script is:inline type="application/json" data-public-interaction-captions set:html={serializePublicInteractionCaptions(locale)} />
    <script is:inline src={languageScriptUrl}></script>
    <script>
      import '../client/theme.js';
      import '../client/service-apps.js';
    </script>
    <script is:inline type="module" src={authStateScriptUrl}></script>
    <script src="../client/pricing-entry.js"></script>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body
    class:list={[
      { "route-home": routeSource === "/" },
      { "route-bali-service": routeSource.startsWith("/bali/") && routeSource !== "/bali/" },
      { "route-visa-catalog": routeSource === "/bali/visas/" },
      { "route-exchange-login": routeSource === "/bali/exchange/usdt-idr/" },
      { "route-download-guide": Boolean(download) },
    ]}
  >
    {world && <WorldBackdrop world={world} home={routeSource === '/'} />}
    <SiteHeader {route} {locale} {languageChoices} />
    <LanguageSuggestion {route} {locale} />
    <main id="content">
      <slot />
    </main>
    <SupportLauncher {locale} />
    <SiteFooter {locale} />
    <AnalyticsConsent {locale}/>
    {world && <script is:inline type="module" src={worldScriptUrl}></script>}
  </body>
</html>
