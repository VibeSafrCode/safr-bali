---
import "../styles/global.css";
import "../styles/interaction-polish.css";
import "../styles/service-apps.css";
import "../styles/destination-worlds.css";
import "../styles/support-dialog.css";
import "../styles/country-picker.css";
import "../styles/bali-services.css";
import "../styles/registry-public.css";
import "../../../shared/design/client-night-palette.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import SupportLauncher from "../components/SupportLauncher.astro";
import WorldBackdrop from "../components/WorldBackdrop.astro";
import authStateScriptUrl from "../client/auth-state.js?url&no-inline";
import languageScriptUrl from "../client/language.js?url&no-inline";
import {canonicalUrl,jsonLdForPage,serializeJsonLd,ogImagePath,ogLocaleFor} from "../lib/seo";
import {publicText} from '../lib/public-i18n';
import {publicLocaleDirection} from '../lib/public-locale';

interface Props {model:any;}
const {model}=Astro.props;
const title=model.seoTitle.includes("SAFRWAY")?model.seoTitle:`${model.seoTitle} — SAFRWAY`;
const canonical=canonicalUrl(model.route);
const ogImage=canonicalUrl(ogImagePath(model.route));
const schemaObjects=jsonLdForPage({route:model.route,title,description:model.description,
  indexable:model.indexable,breadcrumbs:model.breadcrumbs,locale:model.locale,
  homeLabel:publicText('ui.nav.home',model.locale),lastModified:model.lastModified,
  article:!model.commercial});
const faqObject=model.faqSchema?.length?{'@context':'https://schema.org','@type':'FAQPage',
  '@id':canonical+'#faq',mainEntity:model.faqSchema.map((item:any)=>({'@type':'Question',name:item.question,
    acceptedAnswer:{'@type':'Answer',text:item.answer}}))}:null;
if(faqObject)schemaObjects.push(faqObject as any);
const schema=serializeJsonLd(schemaObjects);
const schemaTemplate=(model.seoTitlePriceTemplate||model.seoPriceTemplate||model.faqSchema?.some((item:any)=>
  item.answerTemplate.includes('{{CATALOG_PRICE:')||item.questionTemplate?.includes('{{CATALOG_PRICE:')))?
  serializeJsonLd(schemaObjects.map((item:any)=>item['@type']==='FAQPage'?{...item,mainEntity:item.mainEntity.map((question:any,index:number)=>
    ({...question,name:model.faqSchema[index].questionTemplate??question.name,
      acceptedAnswer:{...question.acceptedAnswer,text:model.faqSchema[index].answerTemplate}}))}:
    ['WebPage','Article'].includes(item['@type'])?{...item,
      ...(model.seoPriceTemplate?{description:model.seoPriceTemplate}:{}),
      ...(model.seoTitlePriceTemplate?{name:model.seoTitlePriceTemplate}:{}),
    }:item)):undefined;
---
<!doctype html>
<html data-public-night="true" lang={model.locale} dir={model.dir} data-locale={model.locale} data-world={model.pageContext.world??undefined} data-theme="dark"
  data-editorial="true" data-ui-locale={model.locale} data-content-id={model.contentId} data-service-id={model.pageContext.serviceSlug??undefined} data-source-revision={model.sourceRevision}
  data-source-path={model.route} data-source-locale={model.locale} data-registry-seo-price-template={model.seoPriceTemplate??undefined}
  data-registry-seo-title-price-template={model.seoTitlePriceTemplate??undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080c15" />
    <title>{title}</title>
    <meta name="description" content={model.description} />
    <meta name="robots" content={model.indexable?"index,follow":"noindex,follow"} />
    <link rel="canonical" href={canonical} />
    {model.alternates.map((entry:any)=><link rel="alternate" hreflang={entry.locale} href={canonicalUrl(entry.href)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={model.commercial?"website":"article"} />
    <meta property="og:locale" content={ogLocaleFor(model.locale)} />
    {model.alternates.filter((entry:any)=>entry.locale!==model.locale&&entry.locale!=="x-default").map((entry:any)=><meta property="og:locale:alternate" content={ogLocaleFor(entry.locale)} />)}
    <meta property="og:site_name" content="SAFRWAY" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={model.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={model.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={model.description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline src={languageScriptUrl}></script>
    <script>
      import '../client/theme.js';
    </script>
    <script is:inline type="module" src={authStateScriptUrl}></script>
    <script src="../client/pricing.js"></script>
    <script is:inline type="application/ld+json" data-registry-price-template={schemaTemplate} set:html={schema} />
  </head>
  <body class="registry-public-page">
    {model.pageContext.world&&<WorldBackdrop world={model.pageContext.world} home={false} />}
    <div lang={model.locale} dir={publicLocaleDirection(model.locale)}>
      <SiteHeader route={model.route} source={model.canonicalPath} locale={model.locale} publicChromeLocale={model.locale}
        articleLocale={model.locale} languageChoices={model.languageChoices} />
    </div>
    <main id="content" class="registry-public" tabindex="-1"><slot /></main>
    <div lang={model.locale} dir={publicLocaleDirection(model.locale)}>
      <SupportLauncher locale={model.locale} />
      <SiteFooter locale={model.locale} />
      <AnalyticsConsent locale={model.locale}/>
    </div>
  </body>
</html>
