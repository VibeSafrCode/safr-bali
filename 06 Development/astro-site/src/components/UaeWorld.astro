---
import BaseLayout from '../layouts/BaseLayout.astro';
import UaeServices from './UaeServices.astro';
import AppDock from './AppDock.astro';
import {worldRoute} from '../lib/destination-worlds';
import {localizedRoute,type PublicSourceLocale} from '../lib/public-i18n';
import {publicSitePageForRoute} from '../lib/public-site-publication';
interface Props {locale:PublicSourceLocale;}
const {locale}=Astro.props;
const page=publicSitePageForRoute(worldRoute('uae',locale)).page;
if(page.route!==worldRoute('uae',locale))throw Error('Standalone public route drift');
---
<BaseLayout route={page.route} title={page.title} description={page.description} indexable={page.indexable} lastModified={page.publication.lastmod} breadcrumbs={[]} locale={locale}>
 <div class="page-shell public-route-country"><section class="country-apps uae-world" data-country-app="uae">
 <a class="app-back" href={localizedRoute('/',locale)}>← {page.backLabel}</a>
 <header class="country-service-heading"><span class="eyebrow">{page.eyebrow}</span><h1>{page.heading}</h1></header>
 <div class="world-service-surface" data-service-count="3"><h2>{page.servicesHeading}</h2><UaeServices locale={locale}/></div>
 <AppDock country="uae" locale={locale}/>
 </section></div>
</BaseLayout>
