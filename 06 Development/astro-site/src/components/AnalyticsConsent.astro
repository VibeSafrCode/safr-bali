---
import scriptUrl from '../client/analytics.js?url&no-inline';
import { publicChromeText, type PublicChromeLocale } from '../lib/public-chrome';
import {publicInteractionText} from '../lib/public-interactions.mjs';
import {localizedPublicRoute} from '../lib/public-locale';
interface Props { locale?: PublicChromeLocale; }
const {locale='ru'}=Astro.props;
const captionLocale=locale;
const privacyHref=localizedPublicRoute('/privacy/',locale);
---
<aside class="analytics-consent" data-analytics-consent data-analytics-save-failed={publicInteractionText("analytics.saveFailed",captionLocale)} hidden aria-label={publicChromeText("analytics.optional", captionLocale)}>
 <p>{publicChromeText("analytics.description", captionLocale)} <a href={privacyHref}>{publicChromeText("analytics.privacy", captionLocale)}</a></p>
 <div><button type="button" data-analytics-accept>{publicChromeText("analytics.allow", captionLocale)}</button><button type="button" data-analytics-decline>{publicChromeText("analytics.decline", captionLocale)}</button></div>
 <p data-analytics-status role="status"></p>
</aside>
<button class="analytics-preferences" type="button" data-analytics-manage hidden>{publicChromeText("analytics.preferences", captionLocale)}</button>
<script is:inline type="module" src={scriptUrl}></script>
<style>
 .analytics-consent{position:fixed;z-index:90;inset:auto 16px 16px;max-width:760px;margin-inline:auto;padding:16px 20px;background:#fbf6eb;color:#292722;border:1px solid #bbb1a1;border-radius:20px;box-shadow:0 12px 40px #0006;font:14px/1.55 system-ui;}
 .analytics-consent p{margin:0 0 10px;}.analytics-consent a{color:inherit;text-decoration:underline;}.analytics-consent div{display:flex;gap:12px;flex-wrap:wrap;}.analytics-consent button,.analytics-preferences{min-height:44px;padding:10px 16px;border-radius:14px;border:1px solid #928f85;background:#fbf6eb;color:#292722;font:inherit;cursor:pointer;}.analytics-preferences{display:block;margin:16px auto;background:#171e2e;color:#fffdf5;font:12px system-ui;}.analytics-consent[hidden],.analytics-preferences[hidden]{display:none;}
 @media(max-width:699px){.analytics-consent{inset:auto 12px 100px;max-height:65dvh;overflow:auto;}}
</style>
