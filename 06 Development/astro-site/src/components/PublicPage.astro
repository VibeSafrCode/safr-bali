---
import Breadcrumbs from "./Breadcrumbs.astro";
import HomeExperience from "./HomeExperience.astro";
import ManagerCta from "./ManagerCta.astro";
import PublicRichText from "./PublicRichText.astro";
import RouteHero from "./RouteHero.astro";
import VisaCatalogHero from "./VisaCatalogHero.astro";
import EditorialArticle from "./EditorialArticle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PublicPage as PublicPageData } from "../lib/public-catalog";
import { normalizePublicContent } from "../lib/public-content.mjs";
import {
  cardVisualForRoute,
  routeClassFor,
  serviceVisualForRoute,
  visualPositionClass,
} from "../lib/route-visuals";
import { publicText, sourceRoute, type PublicLocale } from "../lib/public-i18n";

interface Props {
  page: PublicPageData;
  locale: PublicLocale;
}

const { page, locale } = Astro.props;
const route = sourceRoute(page.route);
const normalizedBody = normalizePublicContent(page.body);
const bodyBlocks = normalizedBody
  .split(/\n{2,}/)
  .map((block) => block.trim())
  .filter(Boolean);
const isCountryGrid =
  page.cards.length > 0 &&
  page.cards.every((card) => card.presentation === "country");
const isVisaArticle =
  route.startsWith("/bali/visas/") && page.cards.length === 0;
const isHome = route === "/";
const isVisaCatalog = route === "/bali/visas/";
const isExchangeLoginPage = route === "/bali/exchange/usdt-idr/";
const exchangeLoginHref = `/api/web/auth/start?return_to=${encodeURIComponent(locale === "en" ? "/en/" : "/")}`;
const routeClass = routeClassFor({ ...page, route });
const hasRouteHero =
  !isHome &&
  !isVisaCatalog &&
  routeClass !== "calculator-gate" &&
  routeClass !== "legal";
const hasCatalogLayout = page.cards.length > 0 && !isHome && !isVisaCatalog;
const serviceVisual = serviceVisualForRoute(route);
const cardVisuals = new Map(
  page.cards.map((card) => [card.href, cardVisualForRoute(sourceRoute(card.href))]),
);
const visualAlt = (visualRoute: string, fallback: string) => {
  const source = sourceRoute(visualRoute);
  const key = source === "/bali/housing/villa/"
    ? "visual.bali.villa.alt"
    : source === "/russia/spb/boat-spb/"
      ? "visual.russia.spb.boat.alt"
      : source === "/russia/spb/"
        ? "visual.russia.spb.alt"
        : source === "/russia/ural/"
          ? "visual.russia.ural.alt"
          : source === "/russia/caucasus/"
            ? "visual.russia.caucasus.alt"
            : null;
  return key ? publicText(key, locale) : fallback;
};
const articleBlocks = page.cards.length
  ? bodyBlocks.slice(1)
  : bodyBlocks[0] === normalizePublicContent(page.lead)
      ? bodyBlocks.slice(1)
      : bodyBlocks;
const articleContent = isExchangeLoginPage ? "" : articleBlocks.join("\n\n");
const pricingTargetForRoute = (candidateRoute: string) => {
  const source = sourceRoute(candidateRoute);
  const visaKey = new Map([
    ["/bali/visas/e33g/", "E33G"],
    ["/bali/visas/d12/", "D12"],
    ["/bali/visas/d1-d2/", "D1/D2"],
    ["/bali/visas/c1/", "C1"],
    ["/bali/visas/voa/", "VOA"],
  ]).get(source);
  if (visaKey) return { type: "VISA", key: visaKey };
  if (source.startsWith("/bali/housing/")) return { type: "SERVICE", key: "housing" };
  if (source === "/bali/guides/all-indonesia/") {
    return { type: "SERVICE", key: "all-indonesia-assistance" };
  }
  return null;
};
const pagePricingTarget = page.editorial?.priceReference ?? pricingTargetForRoute(route);
---

<BaseLayout
  route={page.route}
  title={page.title}
  description={page.description}
  indexable={page.indexable}
  breadcrumbs={page.breadcrumbs}
  download={page.download}
  lastModified={page.publication?.lastmod}
  hasEditorial={Boolean(page.editorial)}
  {locale}
>
  <div class:list={["page-shell", `public-route-${routeClass}`]}>
    {!isHome && !isVisaCatalog && <Breadcrumbs items={page.breadcrumbs} {locale} />}

    {isHome && (
      <HomeExperience eyebrow={page.eyebrow} lead={page.lead} {locale} />
    )}

    {isVisaCatalog && <VisaCatalogHero lead={page.lead} {locale} />}

    {hasRouteHero && <RouteHero {page} {routeClass} {locale} />}

    {!isHome && !isVisaCatalog && !hasRouteHero && <header
      class:list={[
        "page-intro",
        { hero: page.kind === "landing" },
        { "exchange-login-intro": isExchangeLoginPage },
        { "visa-catalog-intro": isVisaCatalog },
      ]}
    >
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{isExchangeLoginPage ? publicText("ui.exchange.title", locale) : page.title}</h1>
      <p class="lead">
        {isExchangeLoginPage
          ? publicText("ui.exchange.lead", locale)
          : page.lead}
      </p>
      {
        page.kind === "landing" && (
          <div class="hero-actions">
            <a class="button button-primary" href="/">
              {publicText("ui.common.openDirections", locale)}
            </a>
            <a class="button button-secondary" href="/account/">
              {publicText("ui.account.title", locale)}
            </a>
          </div>
        )
      }
    </header>}

    {
      isExchangeLoginPage && (
        <section class="exchange-login-cta" aria-labelledby="exchange-login-title">
          <div>
            <h2 id="exchange-login-title">{publicText("ui.exchange.authTitle", locale)}</h2>
            <p>{publicText("ui.exchange.authDescription", locale)}</p>
          </div>
          <div class="exchange-login-actions">
            <a
              class="button button-primary"
              href={exchangeLoginHref}
              data-exchange-auth-action
              data-signed-out-label={publicText("ui.account.signIn", locale)}
              data-signed-in-label={publicText("ui.exchange.openCalculator", locale)}
              data-signed-in-href="https://app.safrway.online/calculator/"
            >{publicText("ui.account.signIn", locale)}</a>
            <a class="button button-secondary" href="/api/web/account-redirect" data-exchange-account-action hidden>
              {publicText("ui.account.title", locale)}
            </a>
          </div>
        </section>
      )
    }

    {
      page.download && (
        <section class="guide-download-card" aria-labelledby="guide-download-title">
          <div>
            <span class="eyebrow">{page.download.meta}</span>
            <h2 id="guide-download-title">{page.download.label}</h2>
            <p>{page.download.recommendation}</p>
          </div>
          <a
            class="button button-primary"
            href={page.download.href}
            download={page.download.fileName}
            type={page.download.mediaType}
            hreflang={page.download.language}
          >
            {page.download.label}
          </a>
        </section>
      )
    }

    {
      page.cards.length > 0 && !isHome && (
        <div class:list={[
          { "public-visa-layout": isVisaCatalog },
          { "public-route-layout": hasCatalogLayout },
        ]}>
        <section
          class:list={[
            "card-grid",
            { "country-grid": isCountryGrid },
            { "public-visa-grid": isVisaCatalog },
            { "public-route-card-grid": hasCatalogLayout },
          ]}
          aria-label={`${publicText("ui.common.catalogAria", locale)}: ${page.title}`}
        >
          {page.cards.map((card) => {
            const cardVisual = cardVisuals.get(card.href);
            return (
            <a
              class:list={[
                "catalog-card",
                { "public-visa-card": isVisaCatalog },
                { "country-card": card.presentation === "country" },
                card.tone ? `country-tone-${card.tone}` : null,
                { available: card.status === "available", soon: card.status === "soon" },
              ]}
              href={card.href}
            >
              {cardVisual && (
                <img
                  class:list={[
                    "public-catalog-card-image",
                    visualPositionClass(cardVisual.position),
                  ]}
                  src={cardVisual.src.src}
                  alt={visualAlt(card.href, cardVisual.alt)}
                  loading="lazy"
                />
              )}
              {!isVisaCatalog && !cardVisual && <span class="catalog-card-icon" aria-hidden="true">{card.icon}</span>}
              <h2>{card.title}</h2>
              <p>{card.summary}</p>
              {pricingTargetForRoute(card.href) ? (
                <small
                  class:list={[{ "catalog-card-price": isVisaCatalog }]}
                  data-canonical-price
                  data-entity-type={pricingTargetForRoute(card.href)?.type}
                  data-entity-key={pricingTargetForRoute(card.href)?.key}
                  hidden
                ></small>
              ) : card.note ? <small>{card.note}</small> : null}
              <strong>
                {card.status === "soon"
                  ? `${publicText("ui.common.askStatus", locale)} →`
                  : `${publicText("ui.common.openPage", locale)} →`}
              </strong>
            </a>
            );
          })}
        </section>
        {hasCatalogLayout && (
          <aside class="public-route-side" aria-label={publicText("ui.common.sectionHelpAria", locale)}>
            <ManagerCta context={page.managerContext} compact {locale} />
          </aside>
        )}
        {isVisaCatalog && (
          <div class="public-visa-side-rail">
            <ManagerCta context={publicText("ui.manager.context.visaSelection", locale)} compact {locale} />
            <section class="public-visa-journey" aria-labelledby="visa-journey-title">
              <h2 id="visa-journey-title">{publicText("ui.visa.journeyTitle", locale)}</h2>
              <ol>
                <li>
                  <span>1</span>
                  <div><strong>{publicText("ui.visa.step1.title", locale)}</strong><p>{publicText("ui.visa.step1.copy", locale)}</p></div>
                </li>
                <li>
                  <span>2</span>
                  <div><strong>{publicText("ui.visa.step2.title", locale)}</strong><p>{publicText("ui.visa.step2.copy", locale)}</p></div>
                </li>
                <li>
                  <span>3</span>
                  <div><strong>{publicText("ui.visa.step3.title", locale)}</strong><p>{publicText("ui.visa.step3.copy", locale)}</p></div>
                </li>
              </ol>
            </section>
            <section class="public-visa-help">
              <strong>{publicText("ui.visa.helpTitle", locale)}</strong>
              <p>{publicText("ui.visa.helpCopy", locale)}</p>
            </section>
          </div>
        )}
        </div>
      )
    }

    {
      pagePricingTarget && (
        <p
          class="canonical-page-price"
          data-canonical-price
          data-entity-type={pagePricingTarget.type}
          data-entity-key={pagePricingTarget.key}
          aria-live="polite"
          hidden
        ></p>
      )
    }

    {
      page.editorial && <EditorialArticle editorial={page.editorial} {locale} eligible={page.indexable} />
    }
    {
      !page.editorial && (route.split("/").includes("visas") || route === "/bali/guides/all-indonesia/") &&
        <section class="article-copy" data-source-review>
          <h2>{locale === "en" ? "Source review pending" : "Проверка источников не завершена"}</h2>
          <p>{locale === "en" ? "The source-check date has not been established. Confirm the conditions for your trip with the team before relying on this overview." : "Дата проверки источников пока не установлена. Уточните условия для вашей поездки у команды, прежде чем полагаться на эту справку."}</p>
        </section>
    }
    {
      (pagePricingTarget || page.editorial) && <noscript><p class="article-copy">{locale === "en" ? "Ask the team for the current service price and included fees. This page does not provide an offline price quote." : "Уточните у менеджера актуальную стоимость сопровождения и включённые сборы. Без JavaScript эта страница не выдаёт ценовое предложение."} <a href="https://t.me/safr_bali_bot">{publicText("ui.support.telegram", locale)}</a></p></noscript>
    }
    {
      page.cards.length > 0 && articleContent && (
        <article class="article-copy">
          <PublicRichText content={articleContent} />
        </article>
      )
    }

    {
      page.cards.length === 0 && articleContent && serviceVisual && (
        <div class="public-service-detail-layout">
          <figure class="public-service-photo">
            <img
              class={visualPositionClass(serviceVisual.position)}
              src={serviceVisual.src.src}
              alt={visualAlt(page.route, serviceVisual.alt)}
            />
          </figure>
          <article class:list={["article-copy", { "visa-copy": isVisaArticle }]}>
            <PublicRichText
              content={articleContent}
              variant={isVisaArticle ? "visa" : "default"}
            />
          </article>
        </div>
      )
    }

    {
      page.cards.length === 0 && articleContent && !serviceVisual && (
        <article class:list={["article-copy", { "visa-copy": isVisaArticle }]}>
          <PublicRichText
            content={articleContent}
            variant={isVisaArticle ? "visa" : "default"}
          />
        </article>
      )
    }

    {
      page.relatedRoutes.length > 0 && (
        <nav class="related-links" aria-label={publicText("ui.common.relatedAria", locale)}>
          <h2>{publicText("ui.common.relatedTitle", locale)}</h2>
          <ul>
            {page.relatedRoutes.map((route) => (
              <li>
                <a href={route.href}>{route.label} →</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {!isHome && !isVisaCatalog && !hasCatalogLayout && <ManagerCta context={page.managerContext} {locale} />}
  </div>
</BaseLayout>
