---
import Breadcrumbs from "./Breadcrumbs.astro";
import ManagerCta from "./ManagerCta.astro";
import PublicRichText from "./PublicRichText.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PublicPage as PublicPageData } from "../lib/public-catalog";
import { normalizePublicContent } from "../lib/public-content.mjs";

interface Props {
  page: PublicPageData;
}

const { page } = Astro.props;
const normalizedBody = normalizePublicContent(page.body);
const bodyBlocks = normalizedBody
  .split(/\n{2,}/)
  .map((block) => block.trim())
  .filter(Boolean);
const isCountryGrid =
  page.cards.length > 0 &&
  page.cards.every((card) => card.presentation === "country");
const isVisaArticle =
  page.route.startsWith("/bali/visas/") && page.cards.length === 0;
const isExchangeLoginPage = page.route === "/bali/exchange/usdt-idr/";
const articleBlocks = page.cards.length
  ? bodyBlocks.slice(1)
  : isVisaArticle
    ? bodyBlocks.slice(1)
    : bodyBlocks[0] === normalizePublicContent(page.lead)
      ? bodyBlocks.slice(1)
      : bodyBlocks;
const articleContent = isExchangeLoginPage ? "" : articleBlocks.join("\n\n");
---

<BaseLayout
  route={page.route}
  title={page.title}
  description={page.description}
  indexable={page.indexable}
  breadcrumbs={page.breadcrumbs}
>
  <div class="page-shell">
    <Breadcrumbs items={page.breadcrumbs} />

    <header
      class:list={[
        "page-intro",
        { hero: page.kind === "landing" },
        { "exchange-login-intro": isExchangeLoginPage },
      ]}
    >
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{isExchangeLoginPage ? "Калькулятор обмена" : page.title}</h1>
      <p class="lead">
        {isExchangeLoginPage
          ? "Расчёт доступен после входа в защищённую зону SAFRWAY."
          : page.lead}
      </p>
      {
        page.kind === "landing" && (
          <div class="hero-actions">
            <a class="button button-primary" href="/catalog/">
              Открыть направления
            </a>
            <a class="button button-secondary" href="/account/">
              Личный кабинет
            </a>
          </div>
        )
      }
    </header>

    {
      isExchangeLoginPage && (
        <section class="exchange-login-cta" aria-labelledby="exchange-login-title">
          <div>
            <h2 id="exchange-login-title">Продолжите после авторизации</h2>
            <p>Войдите, чтобы открыть актуальные направления и предварительный расчёт.</p>
          </div>
          <a class="button button-primary" href="/account/">Войти</a>
        </section>
      )
    }

    {
      page.cards.length > 0 && (
        <section
          class:list={["card-grid", { "country-grid": isCountryGrid }]}
          aria-label={`Каталог: ${page.title}`}
        >
          {page.cards.map((card) => (
            <a
              class:list={[
                "catalog-card",
                { "country-card": card.presentation === "country" },
                card.tone ? `country-tone-${card.tone}` : null,
                { available: card.status === "available", soon: card.status === "soon" },
              ]}
              href={card.href}
            >
              <span class="catalog-card-icon" aria-hidden="true">{card.icon}</span>
              <h2>{card.title}</h2>
              <p>{card.summary}</p>
              {card.note && <small>{card.note}</small>}
              <strong>
                {card.status === "soon" ? "Узнать статус →" : "Открыть страницу →"}
              </strong>
            </a>
          ))}
        </section>
      )
    }

    {
      page.cards.length > 0 && articleContent && (
        <article class="article-copy">
          <PublicRichText content={articleContent} />
        </article>
      )
    }

    {
      page.cards.length === 0 && articleContent && (
        <article class:list={["article-copy", { "visa-copy": isVisaArticle }]}>
          <PublicRichText
            content={articleContent}
            variant={isVisaArticle ? "visa" : "default"}
          />
        </article>
      )
    }

    {
      page.relatedRoutes.length > 0 && (
        <nav class="related-links" aria-label="Связанные страницы">
          <h2>Посмотреть другие варианты</h2>
          <ul>
            {page.relatedRoutes.map((route) => (
              <li>
                <a href={route.href}>{route.label} →</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <ManagerCta context={page.managerContext} />
  </div>
</BaseLayout>
