---
import Breadcrumbs from "./Breadcrumbs.astro";
import HomeExperience from "./HomeExperience.astro";
import ManagerCta from "./ManagerCta.astro";
import PublicRichText from "./PublicRichText.astro";
import RouteHero from "./RouteHero.astro";
import VisaCatalogHero from "./VisaCatalogHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PublicPage as PublicPageData } from "../lib/public-catalog";
import { normalizePublicContent } from "../lib/public-content.mjs";
import {
  cardVisualForRoute,
  routeClassFor,
  serviceVisualForRoute,
} from "../lib/route-visuals";

interface Props {
  page: PublicPageData;
}

const { page } = Astro.props;
const normalizedBody = normalizePublicContent(page.body);
const bodyBlocks = normalizedBody
  .split(/\n{2,}/)
  .map((block) => block.trim())
  .filter(Boolean);
const isCountryGrid =
  page.cards.length > 0 &&
  page.cards.every((card) => card.presentation === "country");
const isVisaArticle =
  page.route.startsWith("/bali/visas/") && page.cards.length === 0;
const isHome = page.route === "/";
const isVisaCatalog = page.route === "/bali/visas/";
const isExchangeLoginPage = page.route === "/bali/exchange/usdt-idr/";
const routeClass = routeClassFor(page);
const hasRouteHero =
  !isHome &&
  !isVisaCatalog &&
  routeClass !== "calculator-gate" &&
  routeClass !== "legal";
const hasCatalogLayout = page.cards.length > 0 && !isHome && !isVisaCatalog;
const serviceVisual = serviceVisualForRoute(page.route);
const cardVisuals = new Map(
  page.cards.map((card) => [card.href, cardVisualForRoute(card.href)]),
);
const articleBlocks = page.cards.length
  ? bodyBlocks.slice(1)
  : isVisaArticle
    ? bodyBlocks.slice(1)
    : bodyBlocks[0] === normalizePublicContent(page.lead)
      ? bodyBlocks.slice(1)
      : bodyBlocks;
const articleContent = isExchangeLoginPage ? "" : articleBlocks.join("\n\n");
---

<BaseLayout
  route={page.route}
  title={page.title}
  description={page.description}
  indexable={page.indexable}
  breadcrumbs={page.breadcrumbs}
>
  <div class:list={["page-shell", `public-route-${routeClass}`]}>
    {!isHome && !isVisaCatalog && <Breadcrumbs items={page.breadcrumbs} />}

    {isHome && (
      <HomeExperience eyebrow={page.eyebrow} lead={page.lead} />
    )}

    {isVisaCatalog && <VisaCatalogHero lead={page.lead} />}

    {hasRouteHero && <RouteHero {page} {routeClass} />}

    {!isHome && !isVisaCatalog && !hasRouteHero && <header
      class:list={[
        "page-intro",
        { hero: page.kind === "landing" },
        { "exchange-login-intro": isExchangeLoginPage },
        { "visa-catalog-intro": isVisaCatalog },
      ]}
    >
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{isExchangeLoginPage ? "Калькулятор обмена" : page.title}</h1>
      <p class="lead">
        {isExchangeLoginPage
          ? "Расчёт доступен после входа в защищённую зону SAFRWAY."
          : page.lead}
      </p>
      {
        page.kind === "landing" && (
          <div class="hero-actions">
            <a class="button button-primary" href="/">
              Открыть направления
            </a>
            <a class="button button-secondary" href="/account/">
              Личный кабинет
            </a>
          </div>
        )
      }
    </header>}

    {
      isExchangeLoginPage && (
        <section class="exchange-login-cta" aria-labelledby="exchange-login-title">
          <div>
            <h2 id="exchange-login-title">Продолжите после авторизации</h2>
            <p>Войдите, чтобы открыть актуальные направления и предварительный расчёт.</p>
          </div>
          <a class="button button-primary" href="/account/">Войти</a>
        </section>
      )
    }

    {
      page.cards.length > 0 && !isHome && (
        <div class:list={[
          { "public-visa-layout": isVisaCatalog },
          { "public-route-layout": hasCatalogLayout },
        ]}>
        <section
          class:list={[
            "card-grid",
            { "country-grid": isCountryGrid },
            { "public-visa-grid": isVisaCatalog },
            { "public-route-card-grid": hasCatalogLayout },
          ]}
          aria-label={`Каталог: ${page.title}`}
        >
          {page.cards.map((card) => {
            const cardVisual = cardVisuals.get(card.href);
            return (
            <a
              class:list={[
                "catalog-card",
                { "public-visa-card": isVisaCatalog },
                { "country-card": card.presentation === "country" },
                card.tone ? `country-tone-${card.tone}` : null,
                { available: card.status === "available", soon: card.status === "soon" },
              ]}
              href={card.href}
            >
              {cardVisual && (
                <img
                  class="public-catalog-card-image"
                  src={cardVisual.src}
                  alt={cardVisual.alt}
                  style={`object-position:${cardVisual.position}`}
                  loading="lazy"
                />
              )}
              {!isVisaCatalog && !cardVisual && <span class="catalog-card-icon" aria-hidden="true">{card.icon}</span>}
              <h2>{card.title}</h2>
              <p>{card.summary}</p>
              {card.note && <small class:list={[{ "catalog-card-price": isVisaCatalog }]}>{card.note}</small>}
              <strong>
                {card.status === "soon" ? "Узнать статус →" : "Открыть страницу →"}
              </strong>
            </a>
            );
          })}
        </section>
        {hasCatalogLayout && (
          <aside class="public-route-side" aria-label="Помощь по разделу">
            <ManagerCta context={page.managerContext} compact />
          </aside>
        )}
        {isVisaCatalog && (
          <div class="public-visa-side-rail">
            <ManagerCta context="подбору визы" compact />
            <section class="public-visa-journey" aria-labelledby="visa-journey-title">
              <h2 id="visa-journey-title">Путь к визе</h2>
              <ol>
                <li>
                  <span>1</span>
                  <div><strong>Выберите визу</strong><p>Сравните цель поездки и срок.</p></div>
                </li>
                <li>
                  <span>2</span>
                  <div><strong>Проверьте детали</strong><p>Откройте страницу подходящего варианта.</p></div>
                </li>
                <li>
                  <span>3</span>
                  <div><strong>Напишите менеджеру</strong><p>Уточните документы в защищённом диалоге.</p></div>
                </li>
              </ol>
            </section>
            <section class="public-visa-help">
              <strong>Команда на связи</strong>
              <p>Вопрос можно отправить через форму поддержки SAFRWAY.</p>
            </section>
          </div>
        )}
        </div>
      )
    }

    {
      page.cards.length > 0 && articleContent && (
        <article class="article-copy">
          <PublicRichText content={articleContent} />
        </article>
      )
    }

    {
      page.cards.length === 0 && articleContent && serviceVisual && (
        <div class="public-service-detail-layout">
          <figure class="public-service-photo">
            <img
              src={serviceVisual.src}
              alt={serviceVisual.alt}
              style={`object-position:${serviceVisual.position}`}
            />
          </figure>
          <article class:list={["article-copy", { "visa-copy": isVisaArticle }]}>
            <PublicRichText
              content={articleContent}
              variant={isVisaArticle ? "visa" : "default"}
            />
          </article>
        </div>
      )
    }

    {
      page.cards.length === 0 && articleContent && !serviceVisual && (
        <article class:list={["article-copy", { "visa-copy": isVisaArticle }]}>
          <PublicRichText
            content={articleContent}
            variant={isVisaArticle ? "visa" : "default"}
          />
        </article>
      )
    }

    {
      page.relatedRoutes.length > 0 && (
        <nav class="related-links" aria-label="Связанные страницы">
          <h2>Посмотреть другие варианты</h2>
          <ul>
            {page.relatedRoutes.map((route) => (
              <li>
                <a href={route.href}>{route.label} →</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {!isHome && !isVisaCatalog && !hasCatalogLayout && <ManagerCta context={page.managerContext} />}
  </div>
</BaseLayout>
