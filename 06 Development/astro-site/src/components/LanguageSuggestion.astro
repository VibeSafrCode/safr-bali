---
import {
  localizedRoute,
  publicText,
  sourceRoute,
  type PublicLocale,
} from "../lib/public-i18n";

interface Props {
  route: string;
  locale: PublicLocale;
}

const { route, locale } = Astro.props;
const englishPath = localizedRoute(sourceRoute(route), "en");
---

<aside
  class="language-suggestion"
  data-language-suggestion
  data-current-locale={locale}
  hidden
  aria-labelledby="language-suggestion-title"
>
  <div>
    <strong id="language-suggestion-title">{publicText("ui.language.promptTitle", locale)}</strong>
  </div>
  <div>
    <a class="language-suggestion-link" href={englishPath} data-language-suggestion-accept>
      {publicText("ui.language.switchEnglish", locale)}
    </a>
    <button class="language-suggestion-dismiss" type="button" aria-label={publicText("ui.language.continueRussian", locale)} title={publicText("ui.language.continueRussian", locale)} data-language-suggestion-decline>
      <span aria-hidden="true">×</span>
    </button>
  </div>
</aside>
