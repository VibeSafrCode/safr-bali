---
import {serviceApps} from '../lib/service-apps';
import {publicComponentText} from '../lib/public-component-copy';

import ServiceApps from './ServiceApps.astro';
import AppDock from './AppDock.astro';
import { getLocalizedDestinations, localizedRoute, sourceRoute, type PublicSourceLocale } from '../lib/public-i18n';
import type { PublicPage } from '../lib/public-catalog';
interface Props { page: PublicPage; locale: PublicSourceLocale; }
const {page, locale} = Astro.props;
const country = sourceRoute(page.route).split('/').filter(Boolean)[0];
const countryName = getLocalizedDestinations(locale).find(item => item.id === country)?.name ?? page.title;
const soon = page.cards.every(c => c.status === 'soon');
---
<section class="country-apps" data-country-app={country}>
  <a class="app-back" href={localizedRoute('/', locale)}>← {publicComponentText('country.back',locale)}</a>
  <header class="country-service-heading"><span class="eyebrow">{publicComponentText('country.eyebrow',locale)}</span><h1>{countryName}</h1></header>
  <div class="world-service-surface" data-service-count={Math.max(1,Math.min(serviceApps(page.cards,country,locale).length,6))}><div class="country-app-heading"><div><span class="eyebrow">SAFRWAY · {publicComponentText('country.travelSpace',locale)}</span><h2>{publicComponentText('country.question',locale)}</h2></div>
    {soon && <span class="app-coming-soon">{publicComponentText('country.preparing',locale)}</span>}
  </div>
  <ServiceApps cards={page.cards} country={country} locale={locale} />
  <div class="app-help-line"><span>{publicComponentText('country.startHelp',locale)}</span><button type="button" data-support-open aria-controls="support-panel" aria-expanded="false">{publicComponentText('country.askAssistant',locale)} <span aria-hidden="true">↗</span></button></div>
  </div>
  <AppDock locale={locale} country={country} />
</section>
