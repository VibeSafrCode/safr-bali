---
import UiIcon from './UiIcon.astro';
import type {PublicSourceLocale} from '../lib/public-i18n';
import {localizedRoute,publicText} from '../lib/public-i18n';
import {getPublicUaeCopy,publicUaeAvailabilityMessage} from '../lib/public-editorial-live';
interface Props {locale:PublicSourceLocale;}
const {locale}=Astro.props;const copy=getPublicUaeCopy(locale);
const apps=[{label:publicText('ui.nav.visas',locale),icon:'▣',tone:'blue'},{label:copy.staysLabel,icon:'⌂',tone:'coral'},{label:copy.assistantLabel,icon:'✦',tone:'purple'}];
---
<p class="world-soon-note">{copy.soonNote}</p>
<div class="service-apps uae-apps" data-app-count="4" data-mobile-app-count="2">{apps.map((app,index)=><>
  {index===2 && <a class="service-app" href={localizedRoute('/uae/insurance/',locale)}><span class="service-app-icon app-tone-cyan"><UiIcon name="shield"/></span><strong>{publicText('catalog.bali.insurance.name',locale)}</strong></a>}
  <button class="service-app" type="button" data-support-open data-support-message={publicUaeAvailabilityMessage(app.label,locale)} aria-controls="support-panel" aria-expanded="false"><span class:list={['service-app-icon',`app-tone-${app.tone}`]}><UiIcon name={app.icon}/></span><strong>{app.label}</strong><small>{publicText('ui.common.soon',locale)}</small></button>
</>)}</div>
