---
import baliHero from "../../../react-app/public/assets/heroes/bali-country-hero-approved.jpg?url";

interface Props {
  lead: string;
  locale: import("../lib/public-i18n").PublicLocale;
}

import { localizedRoute, publicText } from "../lib/public-i18n";

const { lead, locale } = Astro.props;
---

<section class="public-visa-hero" aria-labelledby="public-visa-title">
  <img src={baliHero} alt="" loading="eager" />
  <span class="public-visa-hero-shade" aria-hidden="true"></span>
  <a href={localizedRoute("/bali/", locale)}><span aria-hidden="true">←</span> {publicText("ui.visa.heroBack", locale)}</a>
  <div>
    <span>{publicText("ui.visa.heroEyebrow", locale)}</span>
    <h1 id="public-visa-title">{publicText("ui.visa.heroTitle", locale)}</h1>
    <p>{lead}</p>
  </div>
</section>
