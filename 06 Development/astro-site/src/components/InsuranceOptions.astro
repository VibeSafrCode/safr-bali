---
import { getPublicInsuranceCopy, getPublicInsuranceProviders, publicInsuranceEnquiry,
  type PublicInsuranceLocale } from '../lib/public-insurance';
import '../../../shared/styles/insurance.css';
interface Props { locale: PublicInsuranceLocale; country: string; }
const {locale, country} = Astro.props;
const text = getPublicInsuranceCopy(locale);
const providers = getPublicInsuranceProviders(locale);
---
<section aria-label={text.title}>
  <p class="insurance-note">{text.price} {text.contact}</p>
  <div class="insurance-providers">
    {providers.map(provider => <article class="insurance-provider">
      <h2>{provider.name}</h2>
      <p>{provider.description}</p>
      <a href={provider.url} target="_blank" rel="noopener noreferrer">{text.brandLink}: {provider.name} ↗</a>
      <button class="button button-primary" type="button" data-support-open data-insurance-provider={provider.name} data-support-message={publicInsuranceEnquiry(country,provider.name,locale)} aria-controls="support-panel" aria-expanded="false" aria-label={`${text.cta}: ${provider.name}`}>{text.cta}</button>
    </article>)}
  </div>
  <p class="insurance-note">{text.availability}</p>
</section>
