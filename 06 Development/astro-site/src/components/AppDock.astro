---
import {worldRoute} from '../lib/destination-worlds';
import UiIcon from './UiIcon.astro';
import { type PublicSourceLocale } from '../lib/public-i18n';
import { publicChromeText, type PublicChromeLocale } from '../lib/public-chrome';
interface Props { locale: PublicSourceLocale; country: string; publicChromeLocale?: PublicChromeLocale; }
const {locale, country, publicChromeLocale} = Astro.props;
const captionLocale=publicChromeLocale??locale;
---
<nav class="app-dock" aria-label={publicChromeText("dock.travelServices", captionLocale)}>
  <a href={worldRoute(country, locale)}><UiIcon name="▦" /><span>{publicChromeText("dock.services", captionLocale)}</span></a>
  <a href="/api/web/account-redirect"><UiIcon name="▤" /><span>{publicChromeText("dock.myRequests", captionLocale)}</span></a>
  <button type="button" data-support-open aria-controls="support-panel" aria-expanded="false"><UiIcon name="◌" /><span>{publicChromeText("dock.support", captionLocale)}</span></button>
</nav>
