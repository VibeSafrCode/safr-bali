---
type Breadcrumb = {
  label: string;
  href: string;
};

interface Props {
  items: Breadcrumb[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <ol>
        {items.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
