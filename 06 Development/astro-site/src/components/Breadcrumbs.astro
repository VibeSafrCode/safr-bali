---
type Breadcrumb = {
  label: string;
  href: string;
};

interface Props {
  items: Breadcrumb[];
  locale?: import("../lib/public-i18n").PublicLocale;
}

import { publicText } from "../lib/public-i18n";

const { items, locale = "ru" } = Astro.props;
---

{
  items.length > 0 && (
    <nav class="breadcrumbs" aria-label={publicText("ui.a11y.breadcrumbs", locale)}>
      <ol>
        {items.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
