---
import type { PublicPage } from "../lib/public-catalog";
import {
  heroForRoute,
  visualPositionClass,
  type PublicRouteClass,
} from "../lib/route-visuals";

interface Props {
  page: PublicPage;
  routeClass: PublicRouteClass;
  locale: import("../lib/public-i18n").PublicLocale;
}

import { publicText, sourceRoute } from "../lib/public-i18n";

const { page, routeClass, locale } = Astro.props;
const route = sourceRoute(page.route);
const rawVisual = heroForRoute(route);
const countryId = route.split("/").filter(Boolean)[0];
const visualKey =
  route.startsWith("/bali/housing/villa/")
      ? "visual.bali.villa"
      : route.startsWith("/russia/spb/")
        ? "visual.russia.spb"
        : route.startsWith("/russia/ural/")
          ? "visual.russia.ural"
          : route.startsWith("/russia/caucasus/")
            ? "visual.russia.caucasus"
            : `visual.${countryId}`;
const visual = rawVisual
  ? {
      ...rawVisual,
      alt: publicText(`${visualKey}.alt`, locale),
      label:
          routeClass === "country"
            ? publicText("visual.label.destination", locale)
          : routeClass === "location"
            ? publicText(`${visualKey}.label`, locale)
            : rawVisual.label,
      title:
        routeClass === "country"
          ? publicText(`catalog.destination.${countryId}.name`, locale)
          : routeClass === "location"
            ? publicText(`catalog.russia.${route.split("/").filter(Boolean)[1]}.name`, locale)
            : rawVisual.title,
    }
  : null;
const isNestedRussiaLocation =
  route.startsWith("/russia/spb/") || route.startsWith("/russia/ural/");
const title =
  routeClass === "country" || routeClass === "location"
    ? visual?.title ?? page.title
    : isNestedRussiaLocation
      ? page.title.split(" — ")[0]
      : page.title;
---

{
  visual && (
    <header
      class:list={["public-route-hero", `public-route-hero-${routeClass}`]}
      aria-labelledby="public-route-title"
    >
      <img
        class={visualPositionClass(visual.position)}
        src={visual.src}
        alt={visual.alt}
      />
      <span class="public-route-hero-shade" aria-hidden="true"></span>
      <div>
        <span>{routeClass === "country" || routeClass === "location" ? visual.label : page.eyebrow}</span>
        <h1 id="public-route-title">{title}</h1>
        <p>{page.lead}</p>
      </div>
    </header>
  )
}
