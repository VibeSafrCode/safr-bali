---
interface Props {
  context?: string;
  compact?: boolean;
}

const { context = "этой странице", compact = false } = Astro.props;
---

<aside class:list={["manager-cta", { compact }]}>
  <div>
    <span class="eyebrow">Связь с командой</span>
    <h2>Нужна помощь по {context}?</h2>
    <p>
      Откройте диалог, чтобы отправить сообщение прямо с сайта или
      самостоятельно перейти в Telegram.
    </p>
  </div>
  <button
    class="button button-primary"
    type="button"
    aria-expanded="false"
    aria-controls="support-panel"
    data-support-open
  >
    Написать менеджеру
  </button>
</aside>
