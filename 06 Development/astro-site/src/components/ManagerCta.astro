---
interface Props {
  context?: string;
  compact?: boolean;
  locale?: import("../lib/public-i18n").PublicLocale;
}

import { publicText } from "../lib/public-i18n";

const { context, compact = false, locale = "ru" } = Astro.props;
const resolvedContext = context ?? publicText("ui.manager.context.default", locale);
---

<aside class:list={["manager-cta", { compact }]}>
  <div>
    <span class="eyebrow">{publicText("ui.manager.eyebrow", locale)}</span>
    <h2>{publicText("ui.manager.title", locale, { context: resolvedContext })}</h2>
    <p>{publicText("ui.manager.description", locale)}</p>
  </div>
  <button
    class="button button-primary"
    type="button"
    aria-expanded="false"
    aria-controls="support-panel"
    data-support-open
  >
    {publicText("ui.manager.button", locale)}
  </button>
</aside>
