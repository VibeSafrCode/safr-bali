---
import { Image, getImage } from "astro:assets";
import {worldImages, worldNightImages, worldRoute} from '../lib/destination-worlds';
import UaeServices from './UaeServices.astro';
import homeScriptUrl from "../client/home.js?url&no-inline";
import countryThemeUrl from "../client/country-card-theme.js?url&no-inline";
import ServiceApps from "./ServiceApps.astro";
import UiIcon from "./UiIcon.astro";
import TravelVideos from "./TravelVideos.astro";
import type { Destination } from "../lib/public-catalog";
import {
  getLocalizedDestinations,
  localizedRoute,
  publicText,
  type PublicLocale,
} from "../lib/public-i18n";

interface Props {
  eyebrow?: string;
  lead: string;
  locale: PublicLocale;
}

const { locale } = Astro.props;
const destinations: Destination[] = [...getLocalizedDestinations(locale), {id:'uae',number:'05',name:locale==='en'?'UAE':'ОАЭ',icon:'◇',color:'orange',className:'uae',eyebrow:'',description:'',services:[]}, {id:'vietnam',number:'06',name:locale==='en'?'Vietnam':'Вьетнам',icon:'◇',color:'orange',className:'vietnam',eyebrow:'',description:'',services:[]}];
const order = ['bali', 'thailand', 'uae', 'nepal', 'russia','vietnam'];
destinations.sort((a,b) => order.indexOf(a.id)-order.indexOf(b.id));
const heroByCountry = worldImages;
const nightCards = Object.fromEntries(await Promise.all(order.map(async id => {
  const widths = [240, 480, 720];
  const images = await Promise.all(widths.map(width => getImage({src: worldNightImages[id], width, format:'webp', quality:80})));
  return [id, {src:images[1].src, srcset:images.map((image,index)=>`${image.src} ${widths[index]}w`).join(', ')}];
})));
const countryStatus = (destination: Destination) =>
  destination.services.some((service) => service.status !== "soon")
    ? publicText("ui.common.available", locale)
    : publicText("ui.common.soon", locale);
const helpHeading = (destination: Destination) =>
  destination.id === 'uae' ? (locale === 'en' ? 'Your UAE services' : 'Ваши сервисы в ОАЭ') : destination.id==='vietnam' ? (locale==='en'?'Your Vietnam services':'Ваши сервисы во Вьетнаме') : publicText(`ui.home.help.${destination.id}`, locale);
---

<section class="public-home" data-public-home data-six-countries>
  <header class="public-home-intro" data-world-overview>
    <div>
      <h1 data-phone-copy={locale === "en" ? "Where to?" : "Куда направляетесь?"}>{publicText("ui.home.title", locale)}</h1>
    </div>
    <label class="public-country-search">
      <span>{publicText("ui.home.searchLabel", locale)}</span>
      <UiIcon name="search" />
      <input
        type="search"
        placeholder={publicText("ui.home.searchPlaceholder", locale)}
        autocomplete="off"
        data-phone-placeholder={locale === "en" ? "Country" : "Страна"}
        data-public-country-search
      />
    </label>
  </header>


  <div class="country-carousel-shell" data-world-overview>
  <div class="public-country-rail" role="region" aria-label={publicText("ui.home.destinationsAria", locale)}>
    {destinations.map((destination, index) => (
      <article
        class="public-country-card"
        data-public-country={destination.id}
        data-country-name={destination.name.toLocaleLowerCase(locale === "en" ? "en-US" : "ru-RU")}
        data-country-help={helpHeading(destination)}
        data-world-name={destination.name}
        data-selected={index === 0 ? "true" : "false"}
      >
       <div class="country-card-face">
        <a
          class="public-country-select"
          href={destination.id==='vietnam'?'#public-services-vietnam':worldRoute(destination.id, locale)}
          data-public-country-select={destination.id}
          data-country-route={destination.id==='vietnam'?'':worldRoute(destination.id, locale)}
          aria-current={index === 0 ? "true" : undefined}
          aria-label={publicText("ui.home.showServicesAria", locale, { destination: destination.name })}
        >
          <Image src={heroByCountry[destination.id]} alt=""
            data-country-theme-image
            data-night-src={nightCards[destination.id].src}
            data-night-srcset={nightCards[destination.id].srcset}
            width={480} widths={[240, 480, 720]}
            sizes="(max-width: 699px) 27vw, (max-width: 1279px) 128px, (pointer: coarse) 128px, 20vw"
            format="webp" quality={80}
            loading={index === 0 ? "eager" : "lazy"} />
          <span class="public-country-shade" aria-hidden="true"></span>
          <span class="public-country-copy">
            <small>{countryStatus(destination)}</small>
            <strong>{destination.name}</strong>
          </span>
        </a>
        <span class="public-country-check" aria-hidden="true">✓</span>
       </div>
      </article>
    ))}
  </div>


  </div>

  <p class="public-country-empty" data-public-country-empty hidden role="status">
    {publicText("ui.home.notFound", locale)}
  </p>

  <div class="public-home-dashboard">
    <section class="public-services-panel" aria-labelledby="public-services-title">
      <header>
        <div>
          <h2 id="public-services-title" data-public-services-title aria-live="polite" aria-atomic="true">
            {helpHeading(destinations[0])}
          </h2>
        </div>
      {destinations.filter(destination=>destination.id!=='vietnam').map((destination, index) => (
        <a
          class="public-country-action country-services-open"
          href={worldRoute(destination.id, locale)}
          data-public-country-action={destination.id}
          aria-label={publicText("ui.home.allServices", locale, { destination: destination.name })}
          hidden={index !== 0}
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
      ))}
      </header>
      {destinations.map((destination, index) => (
        <div
          class="public-service-grid"
          id={`public-services-${destination.id}`}
          data-public-services={destination.id}
          data-initially-selected={index === 0 ? "true" : "false"}
        >
          {destination.id === 'vietnam' ? <div class="vietnam-service-contact"><p>{locale==='en'?'Tell us what you need in Vietnam. A manager will confirm available services for your request.':'Напишите, что вам нужно во Вьетнаме. Менеджер уточнит доступные услуги по вашему запросу.'}</p><button type="button" data-support-open data-support-message={locale==='en'?'I have a question about services in Vietnam.':'Хочу уточнить услуги во Вьетнаме.'}>{locale==='en'?'Message a manager':'Написать менеджеру'}</button></div> : destination.id === 'uae' ? <UaeServices locale={locale}/> : <ServiceApps country={destination.id} locale={locale} cards={destination.services.filter(s => !s.publiclyHidden).map(s => ({title:s.name, summary:s.summary, icon:s.icon, href:localizedRoute(`/${destination.id}/${s.id}/`,locale), status:s.status ?? 'available'}))} />}
        </div>
      ))}

    </section>

  </div>
  <div data-world-overview><TravelVideos locale={locale}/></div>

</section>

<script is:inline type="module" src={homeScriptUrl}></script>
<script is:inline type="module" src={countryThemeUrl}></script>
<style>
 :global(html[data-world]) [data-six-countries] .public-country-rail{grid-template-columns:repeat(6,minmax(0,1fr));}
 .vietnam-service-contact{padding:12px;max-width:65ch;}
 .vietnam-service-contact button{min-height:44px;border-radius:16px;padding:10px 18px;background:#d3f0e4;color:#12382d;border:0;font:inherit;cursor:pointer;}
 @media(max-width:1279px){
  :global(html[data-world]) [data-six-countries] .public-country-rail{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-auto-rows:auto;gap:24px 12px;overflow:visible;margin:0;padding:4px 0 14px;}
  /* The row includes both the square image and its caption, not just the image. */
  :global(html[data-world]) [data-six-countries] .public-country-card{width:100%;height:auto;min-width:0;min-height:0;aspect-ratio:auto;grid-template-rows:1fr;border-radius:20px;}
  :global(html[data-world]) [data-six-countries] .country-card-face{height:auto;}
  :global(html[data-world]) [data-six-countries] .public-country-copy{left:10px;bottom:12px;}
  :global(html[data-world]) [data-six-countries] .public-country-copy strong{font-size:clamp(1rem,3vw,1.6rem);}
  :global(html[data-world]) [data-six-countries] .public-country-copy small{font-size:8px;}
 }
</style>
