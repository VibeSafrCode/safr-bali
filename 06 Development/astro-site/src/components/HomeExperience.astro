---
import baliHero from "../../../react-app/public/assets/heroes/bali-country-hero-approved.jpg?url";
import thailandHero from "../../../react-app/public/assets/heroes/thailand-country-hero-approved.jpg?url";
import russiaHero from "../../../react-app/public/assets/heroes/russia-country-hero-approved.jpg?url";
import nepalHero from "../../../react-app/public/assets/heroes/nepal-country-hero-approved.jpg?url";
import homeScriptUrl from "../client/home.js?url&no-inline";
import youtubeScriptUrl from "../client/youtube.js?url&no-inline";
import ManagerCta from "./ManagerCta.astro";
import type { Destination } from "../lib/public-catalog";
import {
  getLocalizedDestinations,
  localizedRoute,
  publicText,
  type PublicLocale,
} from "../lib/public-i18n";

interface Props {
  eyebrow: string;
  lead: string;
  locale: PublicLocale;
}

const { eyebrow, lead, locale } = Astro.props;
const destinations = getLocalizedDestinations(locale);
const heroByCountry: Record<Destination["id"], string> = {
  bali: baliHero,
  thailand: thailandHero,
  russia: russiaHero,
  nepal: nepalHero,
};
const countryStatus = (destination: Destination) =>
  destination.services.some((service) => service.status !== "soon")
    ? publicText("ui.common.available", locale)
    : publicText("ui.common.soon", locale);
const helpHeading = (destination: Destination) =>
  publicText(`ui.home.help.${destination.id}`, locale);
const youtubeVideos = [
  ["OmlTDy12UQ4", "ui.home.youtube.video.serviceOne"],
  ["tIc53sL41VE", "ui.home.youtube.video.serviceTwo"],
  ["keMTgU0CZbE", "ui.home.youtube.video.rentalChats"],
] as const;
---

<section class="public-home" data-public-home>
  <header class="public-home-intro">
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h1>{publicText("ui.home.title", locale)}</h1>
      <p class="lead">{lead}</p>
    </div>
    <label class="public-country-search">
      <span>{publicText("ui.home.searchLabel", locale)}</span>
      <input
        type="search"
        placeholder={publicText("ui.home.searchPlaceholder", locale)}
        autocomplete="off"
        data-public-country-search
      />
    </label>
  </header>

  <div class="public-country-rail" aria-label={publicText("ui.home.destinationsAria", locale)}>
    {destinations.map((destination, index) => (
      <article
        class="public-country-card"
        data-public-country={destination.id}
        data-country-name={destination.name.toLocaleLowerCase(locale === "en" ? "en-US" : "ru-RU")}
        data-country-help={helpHeading(destination)}
        data-selected={index === 0 ? "true" : "false"}
      >
        <a
          class="public-country-select"
          href={`#public-services-${destination.id}`}
          data-public-country-select={destination.id}
          aria-current={index === 0 ? "true" : undefined}
          aria-label={publicText("ui.home.showServicesAria", locale, { destination: destination.name })}
        >
          <img src={heroByCountry[destination.id]} alt="" loading={index === 0 ? "eager" : "lazy"} />
          <span class="public-country-shade" aria-hidden="true"></span>
          <span class="public-country-copy">
            <small>{countryStatus(destination)}</small>
            <strong>{destination.name}</strong>
          </span>
        </a>
        <a class="public-country-details" href={localizedRoute(`/${destination.id}/`, locale)}>
          {publicText("ui.common.details", locale)} <span aria-hidden="true">→</span>
        </a>
        <span class="public-country-check" aria-hidden="true">✓</span>
      </article>
    ))}
  </div>

  <p class="public-country-empty" data-public-country-empty hidden>
    {publicText("ui.home.notFound", locale)}
  </p>

  <div class="public-home-dashboard">
    <section class="public-services-panel" aria-labelledby="public-services-title">
      <header>
        <div>
          <span class="eyebrow">{publicText("ui.home.servicesEyebrow", locale)}</span>
          <h2 id="public-services-title" data-public-services-title>
            {helpHeading(destinations[0])}
          </h2>
        </div>
      </header>
      {destinations.map((destination, index) => (
        <div
          class="public-service-grid"
          id={`public-services-${destination.id}`}
          data-public-services={destination.id}
          data-initially-selected={index === 0 ? "true" : "false"}
        >
          {destination.services
            .filter((service) => !service.publiclyHidden)
            .map((service) => (
              <a class:list={["public-service-card", { soon: service.status === "soon" }]} href={localizedRoute(`/${destination.id}/${service.id}/`, locale)}>
                <span aria-hidden="true">{service.icon}</span>
                <strong>{service.name}</strong>
                <small>{service.summary}</small>
                {service.status === "soon" && <em>{publicText("ui.common.soon", locale)}</em>}
              </a>
            ))}
        </div>
      ))}
      {destinations.map((destination, index) => (
        <a
          class="public-country-action"
          href={localizedRoute(`/${destination.id}/`, locale)}
          data-public-country-action={destination.id}
          hidden={index !== 0}
        >
          {publicText("ui.home.allServices", locale, { destination: destination.name })} <span aria-hidden="true">→</span>
        </a>
      ))}
    </section>

    <div class="public-home-side-rail">
      <ManagerCta context={publicText("ui.manager.context.trip", locale)} compact {locale} />
      <a class="public-account-card" href="/account/">
        <span>{publicText("ui.account.protectedZone", locale)}</span>
        <strong>{publicText("ui.account.title", locale)}</strong>
        <small>{publicText("ui.account.summary", locale)} <span aria-hidden="true">→</span></small>
      </a>
      <section class="public-youtube" aria-labelledby="public-youtube-title">
        <header>
          <span class="eyebrow">{publicText("ui.home.youtube.eyebrow", locale)}</span>
          <h2 id="public-youtube-title">{publicText("ui.home.youtube.title", locale)}</h2>
          <p>{publicText("ui.home.youtube.description", locale)}</p>
        </header>
        <div class="public-youtube-list">
          {youtubeVideos.map(([videoId, titleKey]) => {
            const title = publicText(titleKey, locale);
            return (
              <article class="public-youtube-card" data-youtube-card>
                <button
                  class="public-youtube-load"
                  type="button"
                  data-youtube-load
                  data-youtube-id={videoId}
                  data-youtube-title={title}
                  aria-label={`${publicText("ui.home.youtube.load", locale)}: ${title}`}
                >
                  <span class="public-youtube-mark" aria-hidden="true">▶</span>
                  <strong>{title}</strong>
                  <small>{publicText("ui.home.youtube.load", locale)}</small>
                </button>
              </article>
            );
          })}
        </div>
        <p class="public-youtube-privacy">{publicText("ui.home.youtube.privacy", locale)}</p>
        <a
          class="public-youtube-channel"
          href="https://www.youtube.com/channel/UCeCPrNH3V7E2YK4CtsgyQ_A"
          target="_blank"
          rel="noopener noreferrer"
        >
          {publicText("ui.home.youtube.channel", locale)} <span aria-hidden="true">↗</span>
        </a>
      </section>
    </div>
  </div>
</section>

<script is:inline type="module" src={homeScriptUrl}></script>
<script is:inline type="module" src={youtubeScriptUrl}></script>
