---
import { Image } from "astro:assets";
import {worldImages, worldRoute} from '../lib/destination-worlds';
import UaeServices from './UaeServices.astro';
import homeScriptUrl from "../client/home.js?url&no-inline";
import ServiceApps from "./ServiceApps.astro";
import UiIcon from "./UiIcon.astro";
import TravelVideos from "./TravelVideos.astro";
import type { Destination } from "../lib/public-catalog";
import {
  getLocalizedDestinations,
  localizedRoute,
  publicText,
  type PublicLocale,
} from "../lib/public-i18n";

interface Props {
  eyebrow?: string;
  lead: string;
  locale: PublicLocale;
}

const { locale } = Astro.props;
const destinations: Destination[] = [...getLocalizedDestinations(locale), {id:'uae',number:'05',name:locale==='en'?'UAE':'ОАЭ',icon:'◇',color:'orange',className:'uae',eyebrow:'',description:'',services:[]}];
const order = ['bali', 'thailand', 'uae', 'nepal', 'russia'];
destinations.sort((a,b) => order.indexOf(a.id)-order.indexOf(b.id));
const heroByCountry = worldImages;
const countryStatus = (destination: Destination) =>
  destination.services.some((service) => service.status !== "soon")
    ? publicText("ui.common.available", locale)
    : publicText("ui.common.soon", locale);
const helpHeading = (destination: Destination) =>
  destination.id === 'uae' ? (locale === 'en' ? 'Your UAE services' : 'Ваши сервисы в ОАЭ') : publicText(`ui.home.help.${destination.id}`, locale);
---

<section class="public-home" data-public-home>
  <header class="public-home-intro" data-world-overview>
    <div>
      <h1 data-phone-copy={locale === "en" ? "Where to?" : "Куда направляетесь?"}>{publicText("ui.home.title", locale)}</h1>
    </div>
    <label class="public-country-search">
      <span>{publicText("ui.home.searchLabel", locale)}</span>
      <UiIcon name="search" />
      <input
        type="search"
        placeholder={publicText("ui.home.searchPlaceholder", locale)}
        autocomplete="off"
        data-phone-placeholder={locale === "en" ? "Country" : "Страна"}
        data-public-country-search
      />
    </label>
  </header>


  <div class="country-carousel-shell" data-world-overview>
  <div class="public-country-rail" role="region" aria-label={publicText("ui.home.destinationsAria", locale)}>
    {destinations.map((destination, index) => (
      <article
        class="public-country-card"
        data-public-country={destination.id}
        data-country-name={destination.name.toLocaleLowerCase(locale === "en" ? "en-US" : "ru-RU")}
        data-country-help={helpHeading(destination)}
        data-world-name={destination.name}
        data-selected={index === 0 ? "true" : "false"}
      >
       <div class="country-card-face">
        <a
          class="public-country-select"
          href={worldRoute(destination.id, locale)}
          data-public-country-select={destination.id}
          data-country-route={worldRoute(destination.id, locale)}
          aria-current={index === 0 ? "true" : undefined}
          aria-label={publicText("ui.home.showServicesAria", locale, { destination: destination.name })}
        >
          <Image src={heroByCountry[destination.id]} alt=""
            width={480} widths={[240, 480, 720]}
            sizes="(max-width: 699px) 27vw, (max-width: 1279px) 128px, (pointer: coarse) 128px, 20vw"
            format="webp" quality={80}
            loading={index === 0 ? "eager" : "lazy"} />
          <span class="public-country-shade" aria-hidden="true"></span>
          <span class="public-country-copy">
            <small>{countryStatus(destination)}</small>
            <strong>{destination.name}</strong>
          </span>
        </a>
        <span class="public-country-check" aria-hidden="true">✓</span>
       </div>
      </article>
    ))}
  </div>


  </div>

  <p class="public-country-empty" data-public-country-empty hidden role="status">
    {publicText("ui.home.notFound", locale)}
  </p>

  <div class="public-home-dashboard">
    <section class="public-services-panel" aria-labelledby="public-services-title">
      <header>
        <div>
          <h2 id="public-services-title" data-public-services-title aria-live="polite" aria-atomic="true">
            {helpHeading(destinations[0])}
          </h2>
        </div>
      {destinations.map((destination, index) => (
        <a
          class="public-country-action country-services-open"
          href={worldRoute(destination.id, locale)}
          data-public-country-action={destination.id}
          aria-label={publicText("ui.home.allServices", locale, { destination: destination.name })}
          hidden={index !== 0}
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
      ))}
      </header>
      {destinations.map((destination, index) => (
        <div
          class="public-service-grid"
          id={`public-services-${destination.id}`}
          data-public-services={destination.id}
          data-initially-selected={index === 0 ? "true" : "false"}
        >
          {destination.id === 'uae' ? <UaeServices locale={locale}/> : <ServiceApps country={destination.id} locale={locale} cards={destination.services.filter(s => !s.publiclyHidden).map(s => ({title:s.name, summary:s.summary, icon:s.icon, href:localizedRoute(`/${destination.id}/${s.id}/`,locale), status:s.status ?? 'available'}))} />}
        </div>
      ))}

    </section>

  </div>
  <div data-world-overview><TravelVideos locale={locale}/></div>

</section>

<script is:inline type="module" src={homeScriptUrl}></script>
