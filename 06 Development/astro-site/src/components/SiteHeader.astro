---
interface Props {
  route: string;
  locale: import("../lib/public-i18n").PublicLocale;
}

import { localizedRoute, publicText, sourceRoute } from "../lib/public-i18n";

const { route, locale } = Astro.props;
const source = sourceRoute(route);
const isHome = source === "/";
const isBali = source.startsWith("/bali/") || source === "/bali/";
const isVisas = source.startsWith("/bali/visas/") || source === "/bali/visas/";
const home = localizedRoute("/", locale);
const bali = localizedRoute("/bali/", locale);
const visas = localizedRoute("/bali/visas/", locale);
const ruPath = localizedRoute(source, "ru");
const enPath = localizedRoute(source, "en");
---

<header class="site-header">
  <a class="skip-link" href="#content">{publicText("ui.a11y.skipToContent", locale)}</a>
  <a class="site-brand" href={home} aria-label={publicText("ui.brand.homeAria", locale)}>
    <strong>SAFRWAY</strong>
    <small>{publicText("ui.brand.tagline", locale)}</small>
  </a>
  <nav aria-label={publicText("ui.a11y.primaryNavigation", locale)}>
    <a href={home} aria-current={isHome ? "page" : undefined}>
      <span aria-hidden="true">▦</span>{publicText("ui.nav.directions", locale)}
    </a>
    <a href={bali} aria-current={isBali ? "page" : undefined}>
      <span aria-hidden="true">◇</span>{publicText("ui.nav.bali", locale)}
    </a>
    <a href={visas} aria-current={isVisas ? "page" : undefined}>
      <span aria-hidden="true">▤</span>{publicText("ui.nav.visas", locale)}
    </a>
    <button
      type="button"
      aria-expanded="false"
      aria-controls="support-panel"
      data-support-open
    >
      <span aria-hidden="true">◌</span>{publicText("ui.nav.support", locale)}
    </button>
  </nav>
  <div class="site-appearance-controls">
    <div class="site-language-switch" role="group" aria-label={publicText("ui.language.aria", locale)}>
      <a href={ruPath} lang="ru" hreflang="ru" aria-current={locale === "ru" ? "page" : undefined} data-language-choice="ru">RU</a>
      <a href={enPath} lang="en" hreflang="en" aria-current={locale === "en" ? "page" : undefined} data-language-choice="en">EN</a>
    </div>
    <div class="site-theme-switch" role="group" aria-label={publicText("ui.theme.aria", locale)}>
      <button type="button" aria-label={publicText("ui.theme.light", locale)} aria-pressed="false" data-public-theme-choice="light">☀</button>
      <button type="button" aria-label={publicText("ui.theme.dark", locale)} aria-pressed="true" data-public-theme-choice="dark">◐</button>
    </div>
  </div>
  <a class="site-account-chip" href="/account/">
    <span class="site-account-mark" aria-hidden="true">S</span>
    <span>
      <strong>{publicText("ui.account.title", locale)}</strong>
      <small>{publicText("ui.account.signIn", locale)}</small>
    </span>
    <i aria-hidden="true">→</i>
  </a>
</header>
