---
interface Props {
  route: string;
}

const { route } = Astro.props;
const isHome = route === "/";
const isBali = route.startsWith("/bali/") || route === "/bali/";
const isVisas = route.startsWith("/bali/visas/") || route === "/bali/visas/";
---

<header class="site-header">
  <a class="skip-link" href="#content">Перейти к содержанию</a>
  <a class="site-brand" href="/" aria-label="SAFRWAY — главная">
    <strong>SAFRWAY</strong>
    <small>Ваш человек в другой стране</small>
  </a>
  <nav aria-label="Основная навигация">
    <a href="/" aria-current={isHome ? "page" : undefined}>
      <span aria-hidden="true">▦</span>Направления
    </a>
    <a href="/bali/" aria-current={isBali ? "page" : undefined}>
      <span aria-hidden="true">◇</span>Бали
    </a>
    <a href="/bali/visas/" aria-current={isVisas ? "page" : undefined}>
      <span aria-hidden="true">▤</span>Визы
    </a>
    <button
      type="button"
      aria-expanded="false"
      aria-controls="support-panel"
      data-support-open
    >
      <span aria-hidden="true">◌</span>Поддержка
    </button>
  </nav>
  <a class="site-account-chip" href="/account/">
    <span class="site-account-mark" aria-hidden="true">S</span>
    <span>
      <strong>Личный кабинет</strong>
      <small>Войти</small>
    </span>
    <i aria-hidden="true">→</i>
  </a>
</header>
