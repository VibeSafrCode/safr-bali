---
import supportScriptUrl from "../client/support.js?url&no-inline";
import { publicText, type PublicLocale } from "../lib/public-i18n";

interface Props { locale: PublicLocale }
const { locale } = Astro.props;
---

<div
  class="support-launcher"
  data-support-launcher
  data-support-sending={publicText("ui.support.sending", locale)}
  data-support-sent={publicText("ui.support.sent", locale)}
  data-support-failed={publicText("ui.support.failed", locale)}
>
  <button
    class="support-launcher-button"
    type="button"
    aria-expanded="false"
    aria-controls="support-panel"
    data-support-open
  >
    {publicText("ui.manager.button", locale)}
  </button>

  <section
    class="support-panel"
    id="support-panel"
    aria-labelledby="support-title"
    hidden
    data-support-panel
  >
    <div class="support-panel-header">
      <div>
        <span class="eyebrow">{publicText("ui.manager.eyebrow", locale)}</span>
        <h2 id="support-title">{publicText("ui.manager.button", locale)}</h2>
      </div>
      <button type="button" aria-label={publicText("ui.support.closeAria", locale)} data-support-close>
        ×
      </button>
    </div>

    <p>{publicText("ui.support.description", locale)}</p>

    <form data-support-form>
      <label>
        {publicText("ui.support.name", locale)}
        <input name="name" autocomplete="name" minlength="2" maxlength="120" required />
      </label>
      <label>
        {publicText("ui.support.contact", locale)}
        <input name="contact" autocomplete="email" minlength="3" maxlength="255" required />
      </label>
      <label>
        {publicText("ui.support.message", locale)}
        <textarea name="body" minlength="1" maxlength="4000" rows="5" required></textarea>
      </label>
      <label class="support-honeypot" aria-hidden="true">
        Website
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
      <button class="button button-primary" type="submit" data-support-submit>
        {publicText("ui.support.submit", locale)}
      </button>
      <p class="support-status" role="status" aria-live="polite" data-support-status></p>
    </form>

    <a
      class="button button-secondary"
      href="https://t.me/safr_bali_bot"
      rel="noopener noreferrer"
    >
      {publicText("ui.support.telegram", locale)}
    </a>
  </section>
</div>

<script is:inline type="module" src={supportScriptUrl}></script>
