---
import RegistryFrame from "./RegistryFrame.astro";
import RegistrySections from "./RegistrySections.astro";
interface Props { model: any; nonce: string; styleText: string; }
const {model,nonce,styleText} = Astro.props;
---
<RegistryFrame model={model} nonce={nonce} styleText={styleText}>
  <div class="service-hero">
    <div>
      <h1>{model.title}</h1>
      {model.directHtml && <div class="prose direct-answer" set:html={model.directHtml}></div>}
      {model.introHtml && <div class="prose hero-intro" set:html={model.introHtml}></div>}
    </div>
    <aside class="fact-panel">
      {model.factHtml && model.factHeading && <h2>{model.factHeading}</h2>}
      <div class="prose" set:html={model.factHtml}></div>
      {model.price && <p class="price-line" data-catalog-version={model.price.catalogVersion} data-fx-version={model.price.fxVersion}>
        <bdi dir="ltr">{model.price.idr} IDR</bdi>{" "}
        <span data-preview-usd-expires={model.price.expires}><bdi dir="ltr">{model.price.usdSuffix}</bdi></span>
      </p>}
      <button class="manager-button" type="button" disabled aria-describedby="preview-notice">{model.managerLabel}</button>
      {model.pricingHref && <a class="price-refresh" href={model.pricingHref} lang={model.locale==="ru"?"ru":"en"}>
        {model.locale==="ru" ? "Загрузить опубликованную цену · только чтение" : "Load published price · read only"}
      </a>}
    </aside>
  </div>
  <article class="reading-body"><RegistrySections model={model} /></article>
</RegistryFrame>
