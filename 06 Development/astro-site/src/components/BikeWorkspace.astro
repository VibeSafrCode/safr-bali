---
import UiIcon from './UiIcon.astro';
import {publicComponentText} from '../lib/public-component-copy';
import AppDock from './AppDock.astro';
import {localizedRoute, type PublicSourceLocale} from '../lib/public-i18n';
interface Props {locale: PublicSourceLocale;}
const {locale} = Astro.props;
---
<section class="app-workspace bike-workspace" data-bike-workspace hidden>
  <a class="app-back" href={localizedRoute('/bali/',locale)}>← {publicComponentText('bike.back',locale)}</a>
  <header class="service-workspace-header"><span class="service-app-icon app-tone-orange"><UiIcon name="bike" /></span><div><span class="eyebrow">{publicComponentText('bike.eyebrow',locale)}</span><h2 data-bike-title>{publicComponentText('bike.title',locale)}</h2><p>{publicComponentText('bike.description',locale)}</p></div></header>
  <div class="app-form bike-request"><h2>{publicComponentText('bike.requestTitle',locale)}</h2><p>{publicComponentText('bike.requestDescription',locale)}</p><p class="app-form-note">{publicComponentText('bike.requestNote',locale)}</p><button class="button button-primary app-primary" type="button" data-support-open data-support-message={publicComponentText('bike.message',locale)} aria-controls="support-panel" aria-expanded="false">{publicComponentText('bike.button',locale)} →</button></div>
  <AppDock locale={locale} country="bali" />
</section>
