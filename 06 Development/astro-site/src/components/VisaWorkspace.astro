---
import UiIcon from './UiIcon.astro';
import {localizedRoute, type PublicLocale} from '../lib/public-i18n';
interface Props {locale: PublicLocale;}
const {locale} = Astro.props;
const en = locale === 'en';
const purposeIcons = ['sun','briefcase','laptop','◎'];
const durations = en ? ['Not decided yet', 'Up to 1 month', '1–2 months', 'More than 2 months'] : ['Пока не определился', 'До 1 месяца', '1–2 месяца', 'Больше 2 месяцев'];
const durationLabels = en ? ['Not sure yet', 'Up to 1 month', '1–2 months', 'Over 2 months'] : ['Пока не знаю', 'До 1 месяца', '1–2 месяца', 'Больше 2 месяцев'];
const purposes = en ? ['Holiday', 'Business', 'Remote work', 'Not sure yet'] : ['Отдых', 'Бизнес', 'Удалённая работа', 'Пока не знаю'];
---
<section class="app-workspace visa-workspace" data-visa-workspace data-locale={locale}>
  <a class="app-back" href={localizedRoute('/bali/',locale)}>← {en ? 'Bali services' : 'Сервисы Бали'}</a>
  <header class="service-workspace-header"><span class="service-app-icon app-tone-blue"><UiIcon name="▣" /></span><div><span class="eyebrow">{en ? 'Bali · Your services' : 'Бали · Ваши сервисы'}</span><h1>{en ? 'Visas' : 'Визы'}</h1><p>{en ? 'Start with your trip. We’ll help with the next steps.' : 'Начните с вашей поездки. С остальным поможем.'}</p></div></header>
  <nav class="workspace-tabs" aria-label={en ? 'Visa sections' : 'Разделы визового сервиса'} data-visa-controls hidden>
    <button type="button" data-visa-view="plan" aria-pressed="true" aria-controls="visa-plan">{en ? 'Find a visa' : 'Подобрать визу'}</button>
    <button type="button" data-visa-view="catalog" aria-pressed="false" aria-controls="visa-options">{en ? 'All options' : 'Все варианты'}</button>
    <button type="button" data-visa-view="status" aria-pressed="false" aria-controls="visa-status">{en ? 'My requests' : 'Мои заявки'}</button>
  </nav>
  <section id="visa-plan" class="visa-plan" data-visa-panel="plan">
    <form class="app-form" data-visa-preferences>
      <span class="app-step-label">{en ? 'YOUR TRIP' : 'ВАША ПОЕЗДКА'}</span><h2>{en ? 'What brings you to Bali?' : 'Зачем вы едете на Бали?'}</h2>
      <fieldset><legend class="visually-hidden">{en ? 'Trip purpose' : 'Цель поездки'}</legend><div class="purpose-grid">{purposes.map((purpose,index)=><label class="purpose-choice"><input type="radio" name="purpose" value={purpose} checked={index===0} /><span class="purpose-symbol"><UiIcon name={purposeIcons[index]} /></span><span class="purpose-label">{purpose}</span><span class="purpose-check"><UiIcon name="check" /></span></label>)}</div></fieldset>
      <fieldset class="duration-field"><legend>{en ? 'How long would you like to stay?' : 'На какой срок?'}</legend><div class="duration-options">{durations.map((duration,index)=><label class="duration-choice"><input type="radio" name="duration" value={duration} checked={index===0}/><span>{durationLabels[index]}</span></label>)}</div></fieldset>
      <p class="app-form-note">{en ? 'The assistant will clarify suitable options and requirements for your circumstances.' : 'Ассистент уточнит подходящие варианты и требования для вашей ситуации.'}</p>
      <button class="button button-primary app-primary" type="button" data-support-open data-visa-request aria-controls="support-panel" aria-expanded="false">{en ? 'Discuss my trip' : 'Подобрать визу'} <span aria-hidden="true">→</span></button>
      <small class="app-saved-note" data-visa-saved role="status"></small>
    </form>
    <aside class="app-process"><span class="app-step-label">{en ? 'WE’RE WITH YOU' : 'МЫ РЯДОМ'}</span><h2>{en ? 'A clear next step.' : 'Понятно, что дальше.'}</h2><ol><li><span>1</span><div><strong>{en ? 'Tell us about your trip' : 'Расскажите о поездке'}</strong><p>{en ? 'Your plans and timing.' : 'Ваши планы и сроки.'}</p></div></li><li><span>2</span><div><strong>{en ? 'Clarify the options' : 'Уточним варианты'}</strong><p>{en ? 'Documents, terms and cost.' : 'Документы, условия и стоимость.'}</p></div></li><li><span>3</span><div><strong>{en ? 'Agree on the next steps' : 'Согласуем следующие шаги'}</strong><p>{en ? 'Move forward with your assistant.' : 'Продолжите вместе с ассистентом.'}</p></div></li></ol></aside>
  </section>
  <section id="visa-status" class="app-status" data-visa-panel="status" hidden><span class="service-app-icon app-tone-blue"><UiIcon name="▤" /></span><h2>{en ? 'Your requests, together.' : 'Ваши заявки — в одном месте.'}</h2><p>{en ? 'Sign in to open your account and view available request information.' : 'Войдите в личный кабинет, чтобы посмотреть информацию по вашим заявкам.'}</p><a class="button button-primary" href="https://app.safrway.online/account/visas/">{en ? 'Open my account' : 'Открыть кабинет'}</a></section>
  <noscript><p><a href="#visa-options">{en ? 'Browse all visa options' : 'Посмотреть все варианты виз'}</a></p></noscript>
</section>
