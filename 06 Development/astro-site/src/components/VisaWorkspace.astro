---
import UiIcon from './UiIcon.astro';
import {localizedRoute, type PublicSourceLocale} from '../lib/public-i18n';
import {publicVisaWorkspaceText, publicVisaWorkspaceOptions, type PublicVisaWorkspaceKey} from '../lib/public-visa-workspace';
interface Props {locale: PublicSourceLocale;}
const {locale} = Astro.props;
const visaText = (key: PublicVisaWorkspaceKey) => publicVisaWorkspaceText(key, locale);
const purposeIcons = ['sun','briefcase','laptop','◎'];
const {durations, durationLabels, purposes} = publicVisaWorkspaceOptions(locale);
---
<section class="app-workspace visa-workspace" data-visa-workspace data-locale={locale}>
  <a class="app-back" href={localizedRoute('/bali/',locale)}>← {visaText("public.live.visaWorkspace.backLink")}</a>
  <header class="service-workspace-header"><span class="service-app-icon app-tone-blue"><UiIcon name="▣" /></span><div><span class="eyebrow">{visaText("public.live.visaWorkspace.heroEyebrow")}</span><h1>{visaText("public.live.visaWorkspace.heroTitle")}</h1><p>{visaText("public.live.visaWorkspace.heroDescription")}</p></div></header>
  <nav class="workspace-tabs" aria-label={visaText("public.live.visaWorkspace.tabsAria")} data-visa-controls hidden>
    <button type="button" data-visa-view="plan" aria-pressed="true" aria-controls="visa-plan">{visaText("public.live.visaWorkspace.findVisaTab")}</button>
    <button type="button" data-visa-view="catalog" aria-pressed="false" aria-controls="visa-options">{visaText("public.live.visaWorkspace.catalogTab")}</button>
    <button type="button" data-visa-view="status" aria-pressed="false" aria-controls="visa-status">{visaText("public.live.visaWorkspace.statusTab")}</button>
  </nav>
  <section id="visa-plan" class="visa-plan" data-visa-panel="plan">
    <form class="app-form" data-visa-preferences>
      <span class="app-step-label">{visaText("public.live.visaWorkspace.tripEyebrow")}</span><h2>{visaText("public.live.visaWorkspace.tripPurposeQuestion")}</h2>
      <fieldset><legend class="visually-hidden">{visaText("public.live.visaWorkspace.purposeLegend")}</legend><div class="purpose-grid">{purposes.map((purpose,index)=><label class="purpose-choice"><input type="radio" name="purpose" value={purpose} checked={index===0} /><span class="purpose-symbol"><UiIcon name={purposeIcons[index]} /></span><span class="purpose-label">{purpose}</span><span class="purpose-check"><UiIcon name="check" /></span></label>)}</div></fieldset>
      <fieldset class="duration-field"><legend>{visaText("public.live.visaWorkspace.durationLegend")}</legend><div class="duration-options">{durations.map((duration,index)=><label class="duration-choice"><input type="radio" name="duration" value={duration} checked={index===0}/><span>{durationLabels[index]}</span></label>)}</div></fieldset>
      <p class="app-form-note">{visaText("public.live.visaWorkspace.tripAssistantNote")}</p>
      <button class="button button-primary app-primary" type="button" data-support-open data-visa-request aria-controls="support-panel" aria-expanded="false">{visaText("public.live.visaWorkspace.tripRequestButton")} <span aria-hidden="true">→</span></button>
      <small class="app-saved-note" data-visa-saved role="status"></small>
    </form>
    <aside class="app-process"><span class="app-step-label">{visaText("public.live.visaWorkspace.processEyebrow")}</span><h2>{visaText("public.live.visaWorkspace.processTitle")}</h2><ol><li><span>1</span><div><strong>{visaText("public.live.visaWorkspace.processStep1Title")}</strong><p>{visaText("public.live.visaWorkspace.processStep1Copy")}</p></div></li><li><span>2</span><div><strong>{visaText("public.live.visaWorkspace.processStep2Title")}</strong><p>{visaText("public.live.visaWorkspace.processStep2Copy")}</p></div></li><li><span>3</span><div><strong>{visaText("public.live.visaWorkspace.processStep3Title")}</strong><p>{visaText("public.live.visaWorkspace.processStep3Copy")}</p></div></li></ol></aside>
  </section>
  <section id="visa-status" class="app-status" data-visa-panel="status" hidden><span class="service-app-icon app-tone-blue"><UiIcon name="▤" /></span><h2>{visaText("public.live.visaWorkspace.statusTitle")}</h2><p>{visaText("public.live.visaWorkspace.statusDescription")}</p><a class="button button-primary" href="https://app.safrway.online/account/visas/">{visaText("public.live.visaWorkspace.statusAccountButton")}</a></section>
  <noscript><p><a href="#visa-options">{visaText("public.live.visaWorkspace.noscriptCatalogLink")}</a></p></noscript>
</section>
