---
import UiIcon from './UiIcon.astro';
import {publicComponentText} from '../lib/public-component-copy';
import {publicChromeText} from '../lib/public-chrome';
import {appPresentation} from '../lib/service-apps';
import {getLocalizedDestinations, localizedRoute, sourceRoute, type PublicSourceLocale} from '../lib/public-i18n';
import type {PublicPage} from '../lib/public-catalog';
interface Props {page:PublicPage; locale:PublicSourceLocale;}
const {page,locale}=Astro.props;
const parts=sourceRoute(page.route).split('/').filter(Boolean);
const country=getLocalizedDestinations(locale).find(c=>c.id===parts[0]) ?? (parts[0]==='uae' ? {name:publicChromeText('uae.shortName',locale),services:[]} : undefined);
const service=country?.services.find(s=>s.id===parts[1]);
const app=appPresentation({href:page.route,title:page.title,summary:page.lead,icon:service?.icon??'◎',status:service?.status??'available'},locale);
const soon=service?.status==='soon';
---
<div class="service-entry-header">
 <a class="app-back" href={localizedRoute(`/${parts[0]}/`,locale)}>← {publicComponentText('workspace.backServices',locale,{country__name____parts_0_:country?.name??parts[0]})}</a>
 <header class="service-workspace-header"><span class:list={['service-app-icon',`app-tone-${app.tone}`]}><UiIcon name={app.icon}/></span><div><span class="eyebrow">{country?.name} · SAFRWAY</span><h1>{app.label}</h1><p>{page.lead}</p></div></header>
 {soon && <div class="app-availability"><div><strong>{publicComponentText('workspace.comingSoon',locale)}</strong><p>{publicComponentText('workspace.preparing',locale)}</p></div><button class="button button-primary" type="button" data-support-open data-support-message={publicComponentText('workspace.availabilityMessage',locale,{app_label:app.label,country__name:country?.name??parts[0]})} aria-controls="support-panel" aria-expanded="false">{publicComponentText('workspace.checkAvailability',locale)}</button></div>}
</div>
