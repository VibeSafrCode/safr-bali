---
import {previewHref} from '../../../shared/src/preview-brand.mjs';
import {yorkInformation} from '../lib/information';
import YogaIcon from './YogaIcon.astro';
import ServiceCarousel from './ServiceCarousel.astro';
import YouTubeSection from './YouTubeSection.astro';
const {locale}=Astro.props as {locale:'ru'|'en'};
const t=(ru:string,en:string)=>locale==='ru'?ru:en;
const services=yorkInformation(previewHref('/services/',locale),locale).groups.find(group=>group.id==='bali')?.cards??[];
---
<section class="yoga-hero">
  <div class="hero-copy">
    <p class="eyebrow"><span class="sun-mark" aria-hidden="true">✳</span> {t('Люди. Путешествия. Свобода.','People. Travel. Freedom.')}</p>
    <h1><span>YOGA</span><span>GANSTER<span class="brand-dot">.</span></span></h1>
    <p class="hero-statement">{t('Свой ритм.','Your own rhythm.')}<br/><span>{t('Твой мир.','Your own world.')}</span></p>
    <p class="hero-description">{t('Новые места, простые решения. Всё для жизни и путешествий — рядом.','New places. Simple solutions. Everything for life and travel, within reach.')}</p>
    <div class="hero-actions"><a class="button" href={previewHref('/services/',locale)}>{t('Найти своё направление','Find your next destination')}<YogaIcon name="arrow"/></a><a class="text-link" href={previewHref('/about/',locale)}>{t('Знакомство с проектом','Meet Yoga Ganster')} <span aria-hidden="true">↗</span></a></div>
  </div>
  <div class="hero-art" aria-hidden="true">
    <svg viewBox="0 0 600 720" fill="none" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="sky"><stop stop-color="#564128"/><stop offset="1" stop-color="#181813"/></radialGradient>
        <linearGradient id="sun" x1="150" y1="80" x2="390" y2="460" gradientUnits="userSpaceOnUse"><stop stop-color="#f8df9d"/><stop offset=".56" stop-color="#d99a42"/><stop offset="1" stop-color="#946129"/></linearGradient>
        <linearGradient id="ridge" x1="100" y1="330" x2="500" y2="650" gradientUnits="userSpaceOnUse"><stop stop-color="#776448"/><stop offset="1" stop-color="#1a1c18"/></linearGradient>
      </defs>
      <rect width="600" height="720" fill="url(#sky)"/>
      <circle cx="300" cy="288" r="232" stroke="#dfb76b" stroke-opacity=".16"/>
      <circle cx="300" cy="288" r="210" stroke="#dfb76b" stroke-opacity=".2"/>
      <circle cx="300" cy="288" r="185" fill="url(#sun)"/>
      <path d="M0 560 206 277 354 475 435 369 600 580V720H0Z" fill="url(#ridge)"/>
      <path d="m206 277-49 133 48-30 41 38-16-63 51 60Z" fill="#ead7ac" fill-opacity=".75"/>
      <path d="m0 626 157-147 145 105 126-61 172 128v69H0Z" fill="#242720"/>
      <path d="m0 662 130-54 130 73 150-57 190 52v44H0Z" fill="#141713"/>
      <path d="m216 514 45 88-44 40 51-13 38 49-10-72 69-15-49-13-27-72-32 9Z" stroke="#d6b374" stroke-opacity=".16"/>
      <path d="M300 34v26 M287 47h26 M36 288h26 M49 275v26 M538 288h26 M551 275v26" stroke="#dcb571" stroke-opacity=".5"/>
      <path d="M36 675h528" stroke="#dcc7a0" stroke-opacity=".25"/>
    </svg>
    <span class="art-top">EST. IN FREEDOM</span><span class="art-bottom">TAKE A BREATH. GO FURTHER.</span>
    <span class="art-seal">YG</span>
  </div>
</section>
<section class="home-services" aria-labelledby="home-services-title">
  <div class="section-heading"><div><p class="eyebrow">{t('Меньше забот. Больше жизни.','Less planning. More living.')}</p><h2 id="home-services-title">{t('Всё важное — рядом.','The essentials, together.')}</h2></div><a class="text-link" href={previewHref('/services/',locale)}>{t('Все услуги','All services')} <YogaIcon name="arrow"/></a></div>
  <ServiceCarousel cards={services} {locale} id="home-service-cards" label={t("Услуги на Бали","Services in Bali")}/>
</section>
<section class="journal-teaser"><div><p class="eyebrow">{t('Перед поездкой','Before you go')}</p><h2>{t('Меньше неизвестности.','Know a little more.')}<br/><span>{t('Больше свободы.','Go a little further.')}</span></h2></div><div><p>{t('Визы, документы и жизнь в новой стране. Собрали полезное, чтобы ты мог сосредоточиться на главном.','Visas, documents and life in a new country. Practical guides to help you focus on what matters.')}</p><a class="text-link" href={previewHref('/stories/',locale)}>{t('Открыть материалы','Explore the guides')} <YogaIcon name="arrow"/></a></div></section>
<YouTubeSection {locale}/>
