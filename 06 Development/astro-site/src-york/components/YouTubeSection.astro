---
import YogaIcon from './YogaIcon.astro';
import {youtubeEmbedUrl} from '../../src/client/travel-videos.js';
import videoScript from '../client/yoga-video.js?url&no-inline';
const {locale}=Astro.props as {locale:'ru'|'en'};
const t=(ru:string,en:string)=>locale==='ru'?ru:en;
const id='GhVWrSzvW5w';
const href=`https://www.youtube.com/watch?v=${id}`;
---
<section id="youtube" class="yoga-video" aria-labelledby="youtube-title" data-yoga-video data-embed-url={youtubeEmbedUrl(id)} data-frame-title={t('Видео YouTube','YouTube video')}>
  <div class="section-heading"><div><p class="eyebrow"><YogaIcon name="play"/> YOUTUBE</p><h2 id="youtube-title">{t('Смотри. Вдохновляйся.','Watch. Get inspired.')}</h2></div><div class="video-heading-actions"><button type="button" class="video-close" data-video-close hidden aria-label={t('Закрыть видео','Close video')}><YogaIcon name="close"/></button><a class="text-link" href={href} target="_blank" rel="noopener noreferrer" aria-label={t('Открыть видео на YouTube','Open video on YouTube')}>YouTube <YogaIcon name="arrow"/></a></div></div>
  <div class="video-stage">
    <a class="video-poster" data-video-watch href={href} target="_blank" rel="noopener noreferrer" aria-label={t('Смотреть видео','Watch video')}>
      <img data-video-poster alt="" width="480" height="360" loading="lazy" decoding="async" referrerpolicy="no-referrer" hidden/>
      <span class="video-watch"><span class="video-play-mark" aria-hidden="true"><svg viewBox="0 0 28 20" fill="currentColor"><path d="M8 2v16l14-8Z"/></svg></span><span class="video-watch-label">{t('Смотреть','Watch')}</span></span>
    </a>
    <div class="video-frame" data-video-frame hidden></div>
  </div>
</section>
<script is:inline type="module" src={videoScript}></script>
