---
import YorkPreviewLayout from '../layouts/YorkPreviewLayout.astro';
import PublicRichText from '../../src/components/PublicRichText.astro';
import {previewBrand,previewHref} from '../../../shared/src/preview-brand.mjs';
import {yorkInformation} from '../lib/information';
interface Props {route:string;locale:'ru'|'en';}
const {route,locale}=Astro.props;
const model=yorkInformation(route,locale);
const brand=previewBrand('york-gangster');
if(!brand)throw new Error('Missing synthetic preview brand');
const t=(ru:string,en:string)=>locale==='ru'?ru:en;
const relationship=t(`${brand.displayName} — часть проекта ${brand.parentPlatform}.`,`${brand.displayName} is part of the ${brand.parentPlatform} project.`);
---
<YorkPreviewLayout {route} {locale} title={model.title} description={relationship}>
  <section class="page-intro"><p class="eyebrow">{brand.displayName} · {brand.parentPlatform}</p><h1>{model.title}</h1></section>
  {model.source==='/about/'&&<>
    <section class="panel" data-platform-relationship><h2>{relationship}</h2><p class="lead">{model.home.lead}</p><PublicRichText content={model.home.body}/></section>
    <section class="panel"><h2>{t('Общий каталог услуг','Shared service catalog')}</h2><p>{t('Услуги и материалы берутся из общего каталога SAFRWAY. Эта версия показывает страницы и демонстрационные кабинеты; реальные заявки, регистрация и выплаты не подключены.','Services and articles come from the shared SAFRWAY catalog. This version displays pages and demo accounts; live enquiries, registration and payouts are not connected.')}</p><a class="button" href={previewHref('/services/',locale)}>{t('Посмотреть услуги','Explore services')}</a></section>
  </>}
  {model.source==='/services/'&&<>
    <p class="lead">{model.home.lead}</p>
    <p>{t('Выберите страну в меню вверху или откройте нужную услугу ниже.','Choose a country from the menu above or open a service below.')}</p>
    {model.groups.map(group=><section class="service-group" aria-labelledby={'services-'+group.id} data-service-country={group.id}>
      <h2 id={'services-'+group.id}><a href={group.href}>{group.name}</a></h2>
      <div class="catalog-grid">{group.cards.map(card=><a class="catalog-card" href={card.href}>
        <span class="eyebrow">{card.status==='soon'?t('Скоро','Coming soon'):card.icon}</span><h3>{card.title}</h3><p>{card.summary}</p>{card.note&&<small>{card.note}</small>}<span aria-hidden="true">↗</span>
      </a>)}</div>
    </section>)}
  </>}
  {model.source==='/stories/'&&<>
    <p class="lead">{t('Гайды и статьи из общего каталога SAFRWAY.','Guides and articles from the shared SAFRWAY catalog.')}</p>
    <div class="catalog-grid">{model.reading.map(card=><a class="catalog-card" href={card.href} data-content-id={card.contentId||undefined} data-source-revision={card.sourceRevision||undefined}>
      <h2>{card.title}</h2><p>{card.summary}</p><span aria-hidden="true">↗</span>
    </a>)}</div>
  </>}
  {model.source==='/contacts/'&&<>
    <section class="panel"><h2>{t('Обращение по услуге','Service enquiry')}</h2><p>{t('Ниже можно посмотреть демонстрацию обращения по услуге из общего каталога. Не вводите личные данные: сообщение не отправляется менеджеру и исчезает после обновления страницы.','Below you can try a service enquiry from the shared catalog. Do not enter personal information: no message is sent to a manager, and it disappears after reloading.')}</p><a href={previewHref('/services/',locale)}>{t('Выбрать услугу','Explore services')}</a><p><a href={previewHref('/privacy/',locale)}>{t('Политика конфиденциальности SAFRWAY','SAFRWAY privacy policy')}</a></p></section>
    <div id="york-demo" data-route={route} data-locale={locale}><p>{t('Для демонстрационной формы нужен JavaScript. Команде ничего не отправляется.','JavaScript is needed for the demo form. Nothing is sent to the team.')}</p></div>
    <script is:inline type="module" src="/_york/york-preview.js"></script>
  </>}
</YorkPreviewLayout>
