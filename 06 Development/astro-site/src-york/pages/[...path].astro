---
import YorkPublicPage from '../components/YorkPublicPage.astro';
import YorkDemoPage from '../components/YorkDemoPage.astro';
import YorkNotFound from '../components/YorkNotFound.astro';
import {yorkRoutes,yorkRegistryModel} from '../lib/routes';
export function getStaticPaths() {
  return yorkRoutes().filter(item=>item.route!=='/').map(item=>({params:{path:item.route.slice(1,-1)},props:{item}}));
}
const {item}=Astro.props;
const model=item.entry?yorkRegistryModel(item.entry):null;
---
{item.notFound?<YorkNotFound locale={item.locale}/>:item.demo?<YorkDemoPage route={item.route} locale={item.locale}/>:<YorkPublicPage page={item.page} {model} locale={item.locale}/>}
