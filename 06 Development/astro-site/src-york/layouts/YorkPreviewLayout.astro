---
import '../styles/york.css';
import CountryDropdown from '../components/CountryDropdown.astro';
import YogaIcon from '../components/YogaIcon.astro';
import ServiceMenuItem from '../components/ServiceMenuItem.astro';
import {visaChoices} from '../lib/visa-navigation';
import {yorkInformation} from '../lib/information';
import {previewBrand,previewHref} from '../../../shared/src/preview-brand.mjs';
interface Props {route:string;locale:'ru'|'en';title:string;description?:string;}
const {route,locale,title,description}=Astro.props;
const brand=previewBrand(import.meta.env.SAFRWAY_PREVIEW_BRAND??process.env.SAFRWAY_PREVIEW_BRAND);
if(!brand)throw new Error('Yoga layout requires explicit preview build');
const t=(ru:string,en:string)=>locale==='ru'?ru:en;
const [brandFirst,...brandRest]=brand.displayName.split(' ');
const baliServices=yorkInformation(previewHref('/services/',locale),locale).groups.find(group=>group.id==='bali')?.cards??[];
const baliVisaLinks=[{href:previewHref('/bali/visas/',locale),title:t('Все визы','All visas')},...visaChoices('/bali/visas/',locale)];
const groups=[
 {id:'services',label:t('Услуги','Services'),links:[['/services/',t('Все услуги','All services')],...baliServices.map(card=>[card.href.replace(/^\/en(?=\/)/,''),card.title])]},
 {id:'discover',label:t('Открывай','Explore'),links:[['/stories/',t('Гайды и материалы','Guides & stories')],['/#youtube','YouTube'],['/about/',t('О Yoga Ganster','About Yoga Ganster')],['/contacts/',t('Связаться с командой','Contact the team')]]},
];
const languageHref=(code:'ru'|'en')=>route==='/404/'||route==='/en/404/'?(code==='ru'?'/404.html':'/en/404/'):previewHref(route,code);
---
<!doctype html>
<html lang={locale} dir="ltr" data-preview-brand={brand.brandId} data-preview-only="true">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#121310"/><meta name="robots" content="noindex,nofollow,noarchive"/>
    <meta name="description" content={description??`${brand.displayName} — local, synthetic preview.`}/><title>{title} · {brand.displayName} · DEMO</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{t('К содержимому','Skip to content')}</a>
    <aside class="preview-banner"><span class="preview-dot" aria-hidden="true"></span>{t('Дизайн-превью · тестовые данные · заявки не отправляются','Design preview · sample data · no enquiries are sent')}</aside>
    <header class="site-header shell" data-site-header>
      <a class="wordmark" href={previewHref('/',locale)} aria-label={brand.displayName}><span class="brand-symbol" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18" stroke="currentColor"/><path d="m9 27 11-17 11 17H9Z m7-11 4 7 4-7" stroke="currentColor" stroke-width="1.6"/></svg></span><span class="wordmark-type"><span>{brandFirst.toUpperCase()}</span><span>{brandRest.join(' ').toUpperCase()}<span class="brand-dot" aria-hidden="true">.</span></span></span></a>
      <button class="mobile-menu-toggle" type="button" data-nav-toggle aria-controls="main-navigation" aria-expanded="false" aria-label={t('Меню','Menu')}><span></span><span></span><span></span></button>
      <nav id="main-navigation" class="main-navigation" aria-label={t('Основная навигация','Main navigation')}><CountryDropdown {route} {locale}/><details class="nav-menu bali-visa-menu" data-country-menu><summary aria-controls="menu-bali-visas">{t('Визы на Бали','Bali visas')}<span class="country-chevron"><YogaIcon name="chevron"/></span></summary><div class="country-popover"><p class="menu-eyebrow">{t('Визы на Бали','Bali visas')}</p><nav id="menu-bali-visas" aria-label={t('Все балийские визы','All Bali visas')}>{baliVisaLinks.map(visa=><a href={visa.href} aria-current={route===visa.href?'page':undefined}><span class="menu-link-label"><YogaIcon name="visa"/>{visa.title}</span><span aria-hidden="true">↗</span></a>)}</nav></div></details>{groups.map(group=><details class="nav-menu" data-country-menu><summary aria-controls={'menu-'+group.id}>{group.label}<span class="country-chevron"><YogaIcon name="chevron"/></span></summary><div class="country-popover"><p class="menu-eyebrow">{group.label}</p><nav id={'menu-'+group.id} aria-label={group.label}>{group.links.map(([href,label],index)=><ServiceMenuItem href={previewHref(href,locale)} title={label} {locale} {route} id={'menu-visas-'+group.id+'-'+index}/>)}</nav></div></details>)}<a class="nav-contact" href={previewHref('/contacts/',locale)}>{t('На связи','Let’s talk')} <span aria-hidden="true">↗</span></a></nav>
      <div class="header-tools"><nav class="languages" aria-label={t('Язык','Language')}>{(['ru','en'] as const).map(code=><a href={languageHref(code)} lang={code} aria-current={locale===code?'page':undefined}>{code.toUpperCase()}</a>)}</nav><a class="account-link" href={previewHref('/account/',locale)} aria-label={t('Личный кабинет · демо','Your account · demo')} title={t('Личный кабинет · демо','Your account · demo')}><YogaIcon name="user"/></a></div>
    </header>
    <main id="content" class="shell" tabindex="-1"><slot/></main>
    <section class="partners shell" aria-labelledby="partners-title" data-platform-relationship>
      <div class="partners-intro">
        <svg class="bali-flower" viewBox="0 0 48 40" fill="none" aria-hidden="true"><path d="M24 33C9 23 17 12 24 5c7 7 15 18 0 28Zm0 0C9 32 5 24 5 15c10 1 16 7 19 18Zm0 0c15-1 19-9 19-18-10 1-16 7-19 18ZM7 35h34" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <div><p class="eyebrow" id="partners-title">{t('Наши партнёры','Our partners')}</p><p>{t('Свои люди. Общий путь.','Good people. A shared journey.')}</p></div>
      </div>
      <div class="partner-list">
        <a class="partner-brand" href={previewHref('/about/',locale)+'#partnership'} aria-label={t('О партнёрстве с SAFRWAY','About the SAFRWAY partnership')}>SAFRWAY<span>{t('Путешествия и поддержка','Travel & support')} ↗</span></a>
        <div class="partner-brand partner-fysm"><strong>FYSM</strong><span>{t('Йога-клуб','Yoga club')}</span></div>
      </div>
    </section>
    <footer class="shell site-footer"><span>{brand.displayName}<small>{t('Люди. Путешествия. Свобода.','People. Travel. Freedom.')}</small></span><nav aria-label={t('Дополнительные ссылки','More links')}><a href={previewHref('/privacy/',locale)}>{t('Конфиденциальность','Privacy')}</a><a href={previewHref('/influencer/',locale)}>{t('Партнёрский кабинет · демо','Partner account · demo')}</a><a href={previewHref('/bot-demo/',locale)}>{t('Бот · демо','Bot · demo')}</a></nav></footer>
  </body>
</html>
