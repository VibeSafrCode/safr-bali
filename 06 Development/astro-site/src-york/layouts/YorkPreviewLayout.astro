---
import '../styles/york.css';
import CountryDropdown from '../components/CountryDropdown.astro';
import {previewBrand,previewHref} from '../../../shared/src/preview-brand.mjs';
interface Props {route:string;locale:'ru'|'en';title:string;description?:string;}
const {route,locale,title,description}=Astro.props;
const brand=previewBrand(import.meta.env.SAFRWAY_PREVIEW_BRAND??process.env.SAFRWAY_PREVIEW_BRAND);
if(!brand)throw new Error('York layout requires explicit preview build');
const t=(ru:string,en:string)=>locale==='ru'?ru:en;
const [brandFirst,...brandRest]=brand.displayName.split(' ');
const nav=[['/services/',t('Услуги','Services')],['/about/',t('О проекте','About')],['/contacts/',t('Контакты','Contact')],['/account/',t('Демо клиента','Customer demo')]];
const languageHref=(code:'ru'|'en')=>route==='/404/'||route==='/en/404/'?(code==='ru'?'/404.html':'/en/404/'):previewHref(route,code);
---
<!doctype html>
<html lang={locale} dir="ltr" data-preview-brand={brand.brandId} data-preview-only="true">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="description" content={description??`${brand.displayName} — local, synthetic preview.`} /><title>{title} · {brand.displayName} · DEMO</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{t('К содержимому','Skip to content')}</a>
    <aside class="preview-banner">{t('Локальное демо · синтетические данные · ничего не отправляется и не сохраняется','Local demo · synthetic records · nothing is sent or saved')}</aside>
    <header class="site-header shell">
      <a class="wordmark" href={previewHref('/',locale)} aria-label={brand.displayName}><span>{brandFirst.toUpperCase()}</span><span>{brandRest.join(' ').toUpperCase()}<span class="brand-dot" aria-hidden="true">.</span></span></a>
      <nav class="main-navigation" aria-label={t('Основная навигация','Main navigation')}><CountryDropdown {route} {locale}/>{nav.map(([href,label])=><a href={previewHref(href,locale)} aria-current={route===previewHref(href,locale)?'page':undefined}>{label}</a>)}</nav>
      <nav class="languages" aria-label={t('Язык','Language')}>{(['ru','en'] as const).map(code=><a href={languageHref(code)} lang={code} aria-current={locale===code?'page':undefined}>{code.toUpperCase()}</a>)}</nav>
    </header>
    <main id="content" class="shell" tabindex="-1"><slot /></main>
    <footer class="shell site-footer"><span>{brand.displayName} · DEMO</span><a href={previewHref('/privacy/',locale)}>{t('Конфиденциальность','Privacy')}</a><a href={previewHref('/influencer/',locale)}>{t('Демо партнёра','Partner demo')}</a><a href={previewHref('/bot-demo/',locale)}>{t('Демо бота','Bot demo')}</a></footer>
  </body>
</html>
