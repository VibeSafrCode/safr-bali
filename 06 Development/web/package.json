{
  "name": "safr-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "pnpm run validate:prod-env && pnpm run generate:seo && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:compare": "pnpm run build:vinext-export && pnpm run build:next-export",
    "compare:builds": "node scripts/compare-builds.mjs",
    "build:next-export": "pnpm run validate:prod-env && node scripts/build-variant.mjs next",
    "build:vinext-export": "pnpm run validate:prod-env && node scripts/build-variant.mjs vinext",
    "export:static": "node scripts/export-static.mjs",
    "generate:seo": "node scripts/generate-seo-files.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run test:static && pnpm run test:unit && pnpm run typecheck && pnpm run lint",
    "test:static": "pnpm run build:compare && pnpm run compare:builds && node --test tests/public-routes.test.mjs tests/rendered-html.test.mjs tests/public-env.test.mjs tests/nginx-redirects.test.mjs tests/not-found.test.mjs tests/seo-output.test.mjs tests/artifact-hygiene.test.mjs tests/build-variants.test.mjs tests/client-boundaries.test.mjs",
    "test:unit": "tsx --test tests/api-client.test.ts tests/telegram-sdk.test.ts tests/route-policy.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test:api-client": "tsx --test tests/api-client.test.ts",
    "test:telegram-sdk": "tsx --test tests/telegram-sdk.test.ts",
    "test:routes": "node --test tests/public-routes.test.mjs",
    "test:env": "node --test tests/public-env.test.mjs",
    "test:nginx": "node --test tests/nginx-redirects.test.mjs",
    "test:not-found": "node --test tests/not-found.test.mjs",
    "test:route-policy": "tsx --test tests/route-policy.test.ts",
    "test:seo-output": "node --test tests/seo-output.test.mjs",
    "validate:prod-env": "node scripts/validate-public-env.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .next-official --ignore-pattern out --ignore-pattern artifacts --ignore-pattern test-results --ignore-pattern playwright-report",
    "prepare:release:next": "node scripts/prepare-release.mjs next",
    "prepare:release:vinext": "node scripts/prepare-release.mjs vinext",
    "test:artifacts": "node --test tests/artifact-hygiene.test.mjs",
    "test:build-variants": "node --test tests/build-variants.test.mjs",
    "test:browser": "playwright test",
    "test:browser:next": "SAFR_SMOKE_BUILD=artifacts/build-next-export playwright test",
    "test:browser:vinext": "SAFR_SMOKE_BUILD=artifacts/build-vinext-export playwright test",
    "test:client-boundaries": "node --test tests/client-boundaries.test.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "5.20260727.1",
    "@playwright/test": "1.51.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
