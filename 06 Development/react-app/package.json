{
  "name": "safrway-react-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm run catalog:generate && tsc -b && vite build",
    "build:yoga-mini-app": "tsc -p tsconfig.yoga.json && vite build --config vite.yoga.config.ts",
    "catalog:generate": "node --import ./node_modules/tsx/dist/loader.mjs ../shared/scripts/generate-catalog-snapshot.ts && node --import ./node_modules/tsx/dist/loader.mjs scripts/generate-client-catalog-split.mjs --check",
    "dev": "pnpm run catalog:generate && vite",
    "preview": "vite preview",
    "test": "pnpm run typecheck && pnpm run test:unit && pnpm run build && pnpm run build:yoga-mini-app && pnpm run test:build",
    "test:public": "pnpm run typecheck && pnpm run test:unit:public && pnpm run build && pnpm run build:yoga-mini-app && pnpm run test:build:public",
    "test:browser": "playwright test && playwright test --config=tests/playwright-life.config.ts",
    "test:unit": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:unit:public": "node scripts/client-public-test-profile.mjs",
    "test:build": "node --test tests/*.test.mjs",
    "test:build:public": "node scripts/client-public-build-test-profile.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
