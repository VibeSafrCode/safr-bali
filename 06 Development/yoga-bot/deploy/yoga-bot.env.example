# Separate secret file: primary supplies the Yoga token through its safe flow.
# Primary selects shared_intake for the current product release and supplies
# both credentials separately. Leave values empty until safe operator setup.
YOGA_BOT_TOKEN=
YOGA_MVP_MODE=
YOGA_SITE_ORIGIN=
YOGA_MANAGER_BOT_USERNAME=
YOGA_SHARED_CONTENT_ROOT="/opt/safrway/current/06 Development/shared/content"
YOGA_RUNTIME_LOCK=/run/yoga-gangster-bot/instance.lock
# Required only for shared_intake; no main/admin/backend credential fallback.
YOGA_SERVICE_API_TOKEN=
YOGA_BACKEND_API_ORIGIN=
YOGA_STATE_DIRECTORY=/var/lib/yoga-gangster-bot
