[Unit]
Description=SAFRWAY canonical USDT/IDR refresh
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/tmp
EnvironmentFile=/opt/safr/safr-bali/06 Development/backend/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment="PYTHONPATH=/opt/safr/safr-bali/06 Development/backend"
ExecStart="/opt/safr/safr-bali/06 Development/backend/.venv/bin/python" -m app.scripts.refresh_catalog_fx
TimeoutStartSec=30s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
