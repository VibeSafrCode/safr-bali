PROJECT_NAME=SAFR Bali API
ENVIRONMENT=local
DEBUG=true
SQL_ECHO=false
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
SERVICE_API_TOKEN=change-me-service-token
ADMIN_API_TOKEN=change-me-admin-token
RATE_LIMIT_PER_MINUTE=60
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=safr_bali_bot
MINI_APP_ORIGINS=http://localhost:3000,http://localhost:5173
MINI_APP_ACCESS_COOKIE_NAME=safr_mini_access
MINI_APP_REFRESH_COOKIE_NAME=safr_mini_refresh
MINI_APP_ACCESS_TTL_MINUTES=30
MINI_APP_REFRESH_TTL_DAYS=30
MINI_APP_COOKIE_SECURE=false
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:3000/api/web/auth/callback
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
TELEGRAM_OIDC_AUTH_URL=https://oauth.telegram.org/auth
TELEGRAM_OIDC_TOKEN_URL=https://oauth.telegram.org/token
TELEGRAM_OIDC_JWKS_URL=https://oauth.telegram.org/.well-known/jwks.json
WEBSITE_URL=http://localhost:3000
WEB_SESSION_COOKIE_NAME=safr_session
WEB_SESSION_TTL_DAYS=30
WEB_COOKIE_SECURE=false
DEFAULT_ADMIN_TELEGRAM_ID=0
